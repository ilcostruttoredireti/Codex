# HubSpot private app access token
# Create one at: Settings → Integrations → Private Apps
HUBSPOT_ACCESS_TOKEN=your_hubspot_token_here

# Gmail account to monitor (used to skip self-sent messages)
OWNER_EMAIL=your@gmail.com

# Path to OAuth2 credentials JSON downloaded from Google Cloud Console
GMAIL_CREDENTIALS_FILE=credentials.json

# Path where the script stores the OAuth token after first auth
GMAIL_TOKEN_FILE=gmail_token.json

# File used to track sync state (last timestamp + processed message IDs)
STATE_FILE=.gmail_sync_state.json

# How many days back to look on first run (before any state exists)
SYNC_LOOKBACK_DAYS=7

# Optional: internal name of a custom HubSpot text property to store "Gmail" as source label.
# Create the property in HubSpot → Settings → Properties → Contacts, then paste its internal name here.
# Example: CUSTOM_SOURCE_PROPERTY=contact_source_detail
CUSTOM_SOURCE_PROPERTY=
