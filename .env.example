# ── HubSpot ──────────────────────────────────────────────────────────────────
# Crea un Private App su: https://app.hubspot.com/private-apps
# Scope necessari: crm.objects.contacts.read  crm.objects.contacts.write
HUBSPOT_ACCESS_TOKEN=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Gmail OAuth2 ─────────────────────────────────────────────────────────────
# 1. Vai su https://console.cloud.google.com
# 2. Crea un progetto, abilita "Gmail API"
# 3. Crea credenziali OAuth 2.0 (Desktop app) e scarica il JSON
# 4. Rinominalo credentials.json (o aggiorna il path qui sotto)
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json

# ── Runtime ───────────────────────────────────────────────────────────────────
# File JSON per tracciare lo stato tra un ciclo e l'altro
STATE_FILE_PATH=sync_state.json

# Numero massimo di email da elaborare per ciclo
BATCH_SIZE=50

# Intervallo di polling in secondi (usato con --loop)
POLL_INTERVAL_SECONDS=300
