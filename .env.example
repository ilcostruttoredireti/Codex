# ── Gmail OAuth2 ──────────────────────────────────────────────────────────────
# Path to the OAuth2 client credentials JSON downloaded from Google Cloud Console.
# Required scopes: https://www.googleapis.com/auth/gmail.readonly
GMAIL_CREDENTIALS_FILE=credentials.json

# Path where the authorised token will be saved (created automatically on first run).
GMAIL_TOKEN_FILE=token.json

# ── HubSpot ───────────────────────────────────────────────────────────────────
# Private App access token from HubSpot → Settings → Integrations → Private Apps.
# Required scopes: crm.objects.contacts.read, crm.objects.contacts.write,
#                  crm.objects.notes.write
HUBSPOT_ACCESS_TOKEN=your-hubspot-private-app-token

# ── Sync behaviour ────────────────────────────────────────────────────────────
# How often (in seconds) to poll Gmail for new messages. Default: 60
POLL_INTERVAL_SECONDS=60

# Number of recent messages to process on the very first run. Default: 50
FIRST_RUN_LIMIT=50

# File used to persist polling state between runs. Default: .sync_state.json
STATE_FILE=.sync_state.json
