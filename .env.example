# ─────────────────────────────────────────────────────────────────────────────
# Gmail → HubSpot Sync — Configuration
# Copy this file to .env and fill in the values.
# ─────────────────────────────────────────────────────────────────────────────

# HubSpot private-app access token
# Create one at: Settings → Integrations → Private Apps
# Required scopes: crm.objects.contacts.read, crm.objects.contacts.write,
#                  crm.objects.notes.write
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token_here

# Path to the OAuth credentials JSON downloaded from Google Cloud Console.
# Required OAuth 2.0 scopes: gmail.readonly, gmail.modify, gmail.labels
GMAIL_CREDENTIALS_FILE=credentials.json

# Path where the OAuth token will be stored after first login.
GMAIL_TOKEN_FILE=token.json

# Your own Gmail address(es), comma-separated — these are never synced.
GMAIL_ACCOUNT=you@gmail.com

# How many hours back to look for new emails on each run.
LOOKBACK_HOURS=24

# JSON file used to track already-processed message IDs (avoids duplicates).
STATE_FILE=processed_emails.json
