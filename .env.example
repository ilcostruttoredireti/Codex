# ─── Gmail ────────────────────────────────────────────────────────────────────
# OAuth2 credentials JSON downloaded from Google Cloud Console
# (APIs & Services → Credentials → Desktop app)
GMAIL_CREDENTIALS_FILE=credentials.json

# Auto-generated token file (created on first run after browser auth)
GMAIL_TOKEN_FILE=token.json

# ─── HubSpot ──────────────────────────────────────────────────────────────────
# Private App token from: HubSpot → Settings → Integrations → Private Apps
# Required scopes: crm.objects.contacts.read, crm.objects.contacts.write,
#                  crm.objects.notes.write
HUBSPOT_ACCESS_TOKEN=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ─── Sync behaviour ───────────────────────────────────────────────────────────
# Polling interval in seconds (default: 60)
POLL_INTERVAL_SECONDS=60

# State file path (tracks Gmail historyId and processed message IDs)
STATE_FILE=.sync_state.json

# Process emails already in the inbox on first run (true/false)
PROCESS_INITIAL_EMAILS=false

# Max emails to process on first run (only if PROCESS_INITIAL_EMAILS=true)
INITIAL_EMAILS_MAX=50
