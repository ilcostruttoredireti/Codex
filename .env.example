# ── HubSpot ──────────────────────────────────────────────────────────────────
# Private App token from: HubSpot → Settings → Integrations → Private Apps
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Gmail OAuth ───────────────────────────────────────────────────────────────
# Path to the OAuth 2.0 credentials JSON downloaded from Google Cloud Console
# (APIs & Services → Credentials → OAuth 2.0 Client ID → Desktop app)
GMAIL_CREDENTIALS_FILE=credentials.json

# Path where the access/refresh token will be cached after first login
GMAIL_TOKEN_FILE=token.json
