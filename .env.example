# === Gmail OAuth ===
# Download from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# === HubSpot ===
# Private App token: HubSpot > Settings > Integrations > Private Apps
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# === Sync behaviour ===
# Seconds between Gmail polls (default: 60)
POLL_INTERVAL=60
# Only sync emails received in the last N days on first run (default: 7, 0 = all)
LOOKBACK_DAYS=7
