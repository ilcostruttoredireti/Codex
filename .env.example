# ── HubSpot ────────────────────────────────────────────────────────────────────
# Private App token: HubSpot → Settings → Integrations → Private Apps → Create
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Gmail OAuth ────────────────────────────────────────────────────────────────
# Path to the OAuth2 credentials JSON downloaded from Google Cloud Console
# (APIs & Services → Credentials → OAuth 2.0 Client IDs → Download JSON)
GMAIL_CREDENTIALS_FILE=credentials.json

# Auto-saved OAuth token (created on first run)
GMAIL_TOKEN_FILE=token.json

# ── Sync Settings ──────────────────────────────────────────────────────────────
# How often to poll Gmail for new emails (seconds)
POLL_INTERVAL_SECONDS=60

# Max emails to check per polling cycle
MAX_MESSAGES_PER_POLL=50

# Path to the state file (tracks processed Gmail message IDs)
STATE_FILE=state.json
