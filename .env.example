# HubSpot Private App Token
# Create at: HubSpot → Settings → Integrations → Private Apps
HUBSPOT_TOKEN=your_hubspot_private_app_token_here

# Path to OAuth credentials file downloaded from Google Cloud Console
# Create at: console.cloud.google.com → APIs → Credentials → OAuth 2.0 Client ID
GMAIL_CREDENTIALS_FILE=credentials.json

# Path where the Gmail OAuth token will be stored after first login
GMAIL_TOKEN_FILE=token.json

# Polling interval in seconds (default: 60)
POLL_INTERVAL=60

# Gmail label to monitor (default: INBOX)
GMAIL_LABEL=INBOX

# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO

# Path for persistent sync state (default: sync_state.json)
STATE_FILE=sync_state.json
