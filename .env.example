# Google OAuth2 – download from Google Cloud Console
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# HubSpot private app token (Settings → Integrations → Private Apps)
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token

# Optional: comma-separated emails to never sync
IGNORED_EMAILS=noreply@example.com,system@example.com

# File that tracks processed messages between runs
SYNC_STATE_FILE=.sync_state.json
