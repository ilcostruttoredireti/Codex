# ── Gmail OAuth2 ───────────────────────────────────────────────────────────────
# Path to the OAuth2 credentials JSON downloaded from Google Cloud Console
# (APIs & Services → Credentials → OAuth 2.0 Client ID → Download JSON)
GMAIL_CREDENTIALS_PATH=credentials/gmail_credentials.json

# Path where the script stores the OAuth2 token after the first login
GMAIL_TOKEN_PATH=state/gmail_token.json

# ── HubSpot ────────────────────────────────────────────────────────────────────
# Private App token: HubSpot → Settings → Integrations → Private Apps
# Required scopes: crm.objects.contacts.read, crm.objects.contacts.write,
#                  crm.objects.notes.write
HUBSPOT_ACCESS_TOKEN=pat-xx-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Sync behaviour ─────────────────────────────────────────────────────────────
# Path where the script stores processed email IDs and the Gmail historyId
SYNC_STATE_PATH=state/sync_state.json
