# ── HubSpot ───────────────────────────────────────────────────────────────────
# Crea un Private App su HubSpot → Impostazioni → Integrazioni → App private
# Scope necessari: crm.objects.contacts.read, crm.objects.contacts.write,
#                  crm.objects.notes.write, crm.associations.write
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Gmail ─────────────────────────────────────────────────────────────────────
# 1. Vai su https://console.cloud.google.com
# 2. Crea un progetto, abilita "Gmail API"
# 3. Credenziali → Crea credenziali → ID client OAuth 2.0 (Applicazione desktop)
# 4. Scarica il JSON e salvalo come credentials.json (o cambia il percorso qui sotto)
GMAIL_CREDENTIALS_FILE=credentials.json

# File token generato automaticamente dopo il primo login OAuth (non modificare)
GMAIL_TOKEN_FILE=token.json

# ── Sync ──────────────────────────────────────────────────────────────────────
# La tua email personale: le email inviate da te stesso vengono ignorate
MY_EMAIL=tuo@email.com

# Intervallo di polling in secondi (default: 60)
POLL_INTERVAL_SECONDS=60

# File di stato interno (tiene traccia delle email già processate)
STATE_FILE=.sync_state.json

# Domini da ignorare (separati da virgola, lascia vuoto per nessuno)
# Esempio: esclude email da mailing-list o sistemi automatici noti
SKIP_DOMAINS=noreply.github.com,bounce.example.com

# Modalità test: logga le operazioni senza scrivere su HubSpot (1=attivo, 0=disattivo)
DRY_RUN=0
