# ──────────────────────────────────────────────
# Gmail OAuth2 (scarica credentials.json da
# Google Cloud Console → API & Services → Credentials)
# ──────────────────────────────────────────────
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# ──────────────────────────────────────────────
# HubSpot
# Ottieni il token da: HubSpot → Impostazioni →
# Integrazioni → App private → Crea app privata
# Scopes necessari: crm.objects.contacts.read,
#                   crm.objects.contacts.write
# ──────────────────────────────────────────────
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ──────────────────────────────────────────────
# Comportamento del monitor
# ──────────────────────────────────────────────
# Intervallo di polling in secondi (default: 60)
POLL_INTERVAL_SECONDS=60

# Etichetta Gmail da monitorare (vuoto = INBOX)
GMAIL_LABEL=INBOX

# File per persistere l'ultimo historyId processato
STATE_FILE=.gmail_state.json
