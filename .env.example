# HubSpot Private App access token
# Create one at: HubSpot → Settings → Integrations → Private Apps
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token_here

# Gmail OAuth2 credentials file (downloaded from Google Cloud Console)
GMAIL_CREDENTIALS_FILE=credentials.json

# OAuth2 token storage (auto-generated on first run)
GMAIL_TOKEN_FILE=token.json

# How often to poll Gmail for new messages (seconds)
CHECK_INTERVAL_SECONDS=60

# How many messages to process on the very first run
FIRST_RUN_LIMIT=10
