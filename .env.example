# HubSpot Private App access token
# Create at: HubSpot → Settings → Integrations → Private Apps
# Required scopes: crm.objects.contacts.read, crm.objects.contacts.write,
#                  crm.objects.notes.write
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token_here

# Google OAuth credentials file (downloaded from Google Cloud Console)
# APIs & Services → Credentials → OAuth 2.0 Client ID → Download JSON
GMAIL_CREDENTIALS_PATH=credentials.json

# Where to store the OAuth token after first login (auto-generated)
GMAIL_TOKEN_PATH=token.json

# How often to poll Gmail for new messages (seconds). Default: 60
POLL_INTERVAL_SECONDS=60
