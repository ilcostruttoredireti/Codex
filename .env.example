# HubSpot Private App access token
# Create one at: Settings → Integrations → Private Apps
# Required scopes: crm.objects.contacts.read, crm.objects.contacts.write,
#                  crm.objects.owners.read, timeline
HUBSPOT_ACCESS_TOKEN=your-hubspot-private-app-token-here

# Path to the OAuth2 credentials JSON downloaded from Google Cloud Console
# (APIs & Services → Credentials → OAuth 2.0 Client ID → Desktop app)
GMAIL_CREDENTIALS_FILE=credentials.json

# Token cache — created automatically on first run after browser auth
GMAIL_TOKEN_FILE=token.json

# How often to poll Gmail for new messages (seconds)
POLL_INTERVAL_SECONDS=60

# Internal state file (tracks the Gmail historyId and processed message IDs)
STATE_FILE=.sync_state.json
