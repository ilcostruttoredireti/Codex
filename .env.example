# HubSpot Private App token
# HubSpot → Settings → Integrations → Private Apps → Create a private app
# Required scopes: crm.objects.contacts.read, crm.objects.contacts.write, crm.objects.notes.write
HUBSPOT_API_KEY=pat-na1-xxxxxxxxxxxxxxxxxxxx

# Path to Google OAuth credentials JSON (from Google Cloud Console)
GMAIL_CREDENTIALS_FILE=credentials.json

# Path where the OAuth token will be cached after first login
GMAIL_TOKEN_FILE=token.json

# File used to persist sync state between runs
STATE_FILE=.sync_state.json

# Seconds between inbox polls in daemon mode (default 60)
POLL_INTERVAL_SECONDS=60

# Log verbosity: DEBUG | INFO | WARNING
LOG_LEVEL=INFO
