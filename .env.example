# HubSpot Private App access token
# https://developers.hubspot.com/docs/api/private-apps
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token

# Path to the Gmail OAuth2 credentials JSON downloaded from Google Cloud Console
GMAIL_CREDENTIALS_FILE=credentials.json

# Your own email address – prevents syncing your outgoing replies as contacts
MY_EMAIL=you@yourdomain.com

# Comma-separated list of addresses that forward emails on behalf of others.
# Senders matching these are skipped; the real sender is extracted from the body.
FORWARDING_ADDRESSES=redazione@latestata.it

# How often (seconds) to poll Gmail for new messages (default: 120)
POLL_INTERVAL_SECONDS=120
