# HubSpot Private App token (Settings → Integrations → Private Apps)
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Path al file credentials.json scaricato dalla Google Cloud Console
GOOGLE_CREDENTIALS_FILE=credentials.json

# Path dove salvare il token OAuth Google (generato al primo avvio)
GOOGLE_TOKEN_FILE=token.json

# Secondi tra un ciclo di polling e il successivo (default: 60)
POLL_INTERVAL=60

# File JSON dove tenere traccia dei messaggi già processati
STATE_FILE=sync_state.json
