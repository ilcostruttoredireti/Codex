# HubSpot Private App Token
# Crea un Private App su: HubSpot > Impostazioni > Integrazioni > App Private
# Scope necessari: crm.objects.contacts.read, crm.objects.contacts.write,
#                  crm.objects.notes.read, crm.objects.notes.write
HUBSPOT_TOKEN=your_hubspot_private_app_token_here

# Gmail OAuth credentials (scarica da Google Cloud Console)
# Abilita Gmail API e crea credenziali OAuth 2.0 di tipo "Desktop app"
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# Intervallo di polling in secondi (default: 60)
POLL_INTERVAL_SECONDS=60

# File di stato per tracciare i messaggi già processati
STATE_FILE=sync_state.json
