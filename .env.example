# HubSpot Private App Access Token
# Crea un Private App in HubSpot: Settings → Integrations → Private Apps
HUBSPOT_ACCESS_TOKEN=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# File delle credenziali OAuth2 di Gmail (scarica da Google Cloud Console)
GMAIL_CREDENTIALS_FILE=credentials.json

# File token OAuth2 generato al primo login (creato automaticamente)
GMAIL_TOKEN_FILE=token.json

# Intervallo di polling in secondi (default: 60)
POLL_INTERVAL_SECONDS=60

# Quanti giorni di email scansionare al primo avvio (default: 7)
INITIAL_LOOKBACK_DAYS=7
