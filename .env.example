# HubSpot Private App Access Token
# Crea una Private App su: https://app.hubspot.com/private-apps
# Scopes richiesti: crm.objects.contacts.read, crm.objects.contacts.write, crm.objects.notes.write
HUBSPOT_ACCESS_TOKEN=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Gmail OAuth2 — file generato dalla Google Cloud Console
# https://console.cloud.google.com/apis/credentials
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.pickle

# Polling: controlla nuove email ogni N secondi (default: 60)
POLL_INTERVAL_SECONDS=60

# Livello log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
