# Copy to .env and fill in your values
# Load with: export $(cat .env | xargs)

# HubSpot Private App access token
# Create at: HubSpot → Settings → Integrations → Private Apps
# Required scopes: crm.objects.contacts.read, crm.objects.contacts.write,
#                  crm.objects.notes.write, crm.associations.write
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# How often to poll in watch mode (seconds, default 60)
POLL_INTERVAL=60
