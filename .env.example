# ── HubSpot ───────────────────────────────────────────────────────────────────
# Private App access token from HubSpot Settings → Integrations → Private Apps
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token_here

# ── Gmail OAuth ───────────────────────────────────────────────────────────────
# Path to the credentials.json downloaded from Google Cloud Console
# (APIs & Services → Credentials → OAuth 2.0 Client IDs → Download JSON)
GMAIL_CREDENTIALS_FILE=credentials.json

# Path where the OAuth token will be saved after first login
GMAIL_TOKEN_FILE=token.json

# ── Sync behaviour ────────────────────────────────────────────────────────────
# How often to poll Gmail for new emails (in seconds)
POLL_INTERVAL_SECONDS=120

# Max number of inbox messages to fetch per poll cycle
INBOX_MAX_RESULTS=50

# Path to the JSON file that tracks already-processed message IDs
STATE_FILE=sync_state.json
