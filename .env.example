# ─── Gmail ───────────────────────────────────────────────────────────────────
# Path to the OAuth2 client secrets JSON downloaded from Google Cloud Console.
# Enable the Gmail API and create an "OAuth 2.0 Client ID" (Desktop app type).
GOOGLE_CREDENTIALS_PATH=credentials.json

# Path where the OAuth2 token will be stored after the first login.
GOOGLE_TOKEN_PATH=token.json

# ─── HubSpot ─────────────────────────────────────────────────────────────────
# Private App token from HubSpot → Settings → Integrations → Private Apps.
# Required scopes: crm.objects.contacts.read, crm.objects.contacts.write,
#                  crm.objects.notes.write
HUBSPOT_API_TOKEN=your-hubspot-private-app-token-here

# ─── Sync behaviour ──────────────────────────────────────────────────────────
# How often to poll Gmail for new messages (seconds).
POLL_INTERVAL_SECONDS=60

# File where the sync state (historyId + processed message IDs) is persisted.
STATE_FILE=sync_state.json
