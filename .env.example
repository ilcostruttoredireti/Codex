# ── Gmail OAuth ───────────────────────────────────────────────────────────────
# Path to the OAuth2 credentials JSON downloaded from Google Cloud Console
# (APIs & Services → Credentials → OAuth 2.0 Client IDs → Download JSON)
GMAIL_CREDENTIALS_FILE=credentials.json

# Where the script stores the refreshable token after the first login
GMAIL_TOKEN_FILE=token.json

# Gmail search filter for "recent" emails (see Gmail search operators)
# Examples: "newer_than:1d", "newer_than:7d", "after:2024/01/01"
GMAIL_LOOKBACK=newer_than:1d

# Maximum number of emails to fetch per cycle
MAX_RESULTS=50

# ── HubSpot ───────────────────────────────────────────────────────────────────
# Private App access token from HubSpot
# (Settings → Integrations → Private Apps → Create a private app)
# Required scopes: crm.objects.contacts.read, crm.objects.contacts.write,
#                  crm.objects.notes.write
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Sync behaviour ────────────────────────────────────────────────────────────
# Polling interval in seconds (default: 60)
POLL_INTERVAL=60

# File used to track already-processed Gmail message IDs
STATE_FILE=.processed_emails.json
