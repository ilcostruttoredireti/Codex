# HubSpot Private App access token
# Create one at: Settings → Integrations → Private Apps
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token

# Path to the Google OAuth2 credentials JSON downloaded from Google Cloud Console
GMAIL_CREDENTIALS_FILE=credentials.json

# Path where the OAuth token will be cached after first login
GMAIL_TOKEN_FILE=token.json

# How often to check for new emails (seconds). Default: 300 (5 min)
POLL_INTERVAL_SECONDS=300

# Set to "true" to run a single sync pass then exit (useful for cron jobs)
RUN_ONCE=false
