# Copy to .env and fill in real values

# Path to the OAuth2 credentials JSON downloaded from Google Cloud Console
# (APIs & Services > Credentials > OAuth 2.0 Client ID > Download JSON)
GMAIL_CREDENTIALS_FILE=credentials.json

# Where the script stores the OAuth access token after first login
GMAIL_TOKEN_FILE=token.json

# HubSpot Private App token
# (HubSpot Settings > Integrations > Private Apps > Create app)
# Required scopes: crm.objects.contacts.read, crm.objects.contacts.write
HUBSPOT_ACCESS_TOKEN=pat-xx-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Gmail address to monitor (leave as "me" to use the authenticated account)
GMAIL_USER_EMAIL=me

# How many hours to look back on the very first run (before any state file exists)
LOOKBACK_HOURS=24

# File that persists last-run timestamp between executions
STATE_FILE=.sync_state.json
