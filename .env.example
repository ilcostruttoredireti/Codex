# ── HubSpot ──────────────────────────────────────────────────────────────────
# Private App access token (Settings → Integrations → Private Apps)
# Required scopes: crm.objects.contacts.read, crm.objects.contacts.write
#                  crm.objects.notes.write (only if HUBSPOT_CREATE_ACTIVITY=true)
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Gmail ─────────────────────────────────────────────────────────────────────
# Path to the OAuth2 credentials JSON downloaded from Google Cloud Console
# (APIs & Services → Credentials → Create OAuth 2.0 Client ID → Desktop app)
GMAIL_CREDENTIALS_FILE=credentials.json

# ── Sync behaviour ───────────────────────────────────────────────────────────
# Your own email address — messages sent by you are skipped
MY_EMAIL=tu@example.com

# Seconds between each inbox check (default: 60)
POLL_INTERVAL_SECONDS=60

# Set to 'true' to create a HubSpot timeline note for every inbound email
# Requires the crm.objects.notes.write scope on the Private App
HUBSPOT_CREATE_ACTIVITY=false
