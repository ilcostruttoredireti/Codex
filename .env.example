# HubSpot Private App token
# https://app.hubspot.com/private-apps
HUBSPOT_ACCESS_TOKEN=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Google OAuth2 — scarica da Google Cloud Console
# Tipo app: Desktop, scopes: gmail.readonly
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# Secondi tra un ciclo di polling e l'altro (default 60)
POLL_INTERVAL_SECONDS=60

# File di stato (IDs messaggi già elaborati)
STATE_FILE=processed_messages.txt
