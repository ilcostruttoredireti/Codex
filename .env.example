# ── HubSpot ──────────────────────────────────────────────────────────────────
# Private App access token (Settings → Integrations → Private Apps)
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Gmail OAuth ───────────────────────────────────────────────────────────────
# Path to the OAuth 2.0 client credentials JSON downloaded from Google Cloud Console
GMAIL_CREDENTIALS_FILE=credentials.json
# Where the authorised token is cached after the first browser login
GMAIL_TOKEN_FILE=token.json

# ── Polling ───────────────────────────────────────────────────────────────────
# How often (in seconds) to check Gmail for new messages
POLL_INTERVAL_SECONDS=60

# ── State ─────────────────────────────────────────────────────────────────────
# File used to persist the Gmail history ID and processed message IDs
STATE_FILE=.sync_state.json

# ── Logging ───────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
