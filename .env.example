# ── HubSpot ───────────────────────────────────────────────────────────────────
# Private App access token from HubSpot → Settings → Integrations → Private Apps
HUBSPOT_ACCESS_TOKEN=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Gmail OAuth ───────────────────────────────────────────────────────────────
# Path to the client_secret JSON downloaded from Google Cloud Console
GMAIL_CREDENTIALS_FILE=credentials.json
# Path where the script caches the OAuth token after first login
GMAIL_TOKEN_FILE=token.json

# ── Sync behaviour ────────────────────────────────────────────────────────────
# Your own email addresses (comma-separated) — never synced as contacts
OWN_EMAILS=cristian.mameli.editore@gmail.com,redazione@latestata.it,pubblica.latestata@gmail.com

# Polling interval in seconds when running with --continuous (default: 300 = 5 min)
POLL_INTERVAL_SECONDS=300

# Maximum Gmail threads fetched per sync pass (default: 200)
MAX_THREADS_PER_PASS=200

# Set to "true" to preview without writing to HubSpot
DRY_RUN=false

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Path for the JSON file that tracks already-processed thread IDs
SYNC_STATE_FILE=sync_state.json
