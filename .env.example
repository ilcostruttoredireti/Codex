# HubSpot private-app access token
# Create at: HubSpot → Settings → Integrations → Private Apps
# Required scopes: crm.objects.contacts.read, crm.objects.contacts.write,
#                  crm.objects.notes.write
HUBSPOT_ACCESS_TOKEN=your-hubspot-private-app-token-here

# Path to the Gmail OAuth2 credentials JSON file
# Download from: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Enable Gmail API first: https://console.cloud.google.com/apis/library/gmail.googleapis.com
GMAIL_CREDENTIALS_FILE=credentials.json
