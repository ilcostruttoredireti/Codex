# ── HubSpot ──────────────────────────────────────────────────
# Ottieni il token da: HubSpot → Impostazioni → Integrazioni → App private
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Gmail OAuth2 ─────────────────────────────────────────────
# Scarica credentials.json da Google Cloud Console (OAuth 2.0 Client IDs)
# https://console.cloud.google.com/apis/credentials
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json

# ── Comportamento sync ────────────────────────────────────────
# Intervallo di polling in secondi (default: 60)
POLL_INTERVAL_SECONDS=60

# Label Gmail applicata ai messaggi già processati
PROCESSED_LABEL_NAME=HubSpot-Synced

# Query Gmail per filtrare i messaggi da processare
# Default: email in inbox non ancora lette
GMAIL_QUERY=in:inbox is:unread
