# HubSpot Private App Token (Settings > Integrations > Private Apps)
HUBSPOT_ACCESS_TOKEN=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Percorsi file credenziali Gmail (OAuth2)
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json

# Intervallo polling in secondi (default: 60)
POLL_INTERVAL_SECONDS=60

# File di stato per il tracking (historyId + ID processati)
STATE_FILE_PATH=sync_state.json

# Retroattività primo avvio: quanti giorni di email storica caricare (default: 7)
INITIAL_LOOKBACK_DAYS=7
