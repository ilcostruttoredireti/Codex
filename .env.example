# Google OAuth credentials (download from Google Cloud Console → APIs & Services → Credentials)
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# HubSpot Private App access token
# Crea un'app privata in: HubSpot → Settings → Integrations → Private Apps
# Scope necessari: crm.objects.contacts.read, crm.objects.contacts.write, crm.objects.notes.write
HUBSPOT_ACCESS_TOKEN=your_hubspot_access_token_here

# Intervallo di polling in secondi (default: 60)
POLL_INTERVAL=60

# File di stato per tracciare le email già processate
STATE_FILE=state.json

# Livello di log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
