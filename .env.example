# ── HubSpot ─────────────────────────────────────────────────────────────────
# Token dell'app privata HubSpot (Impostazioni > Integrazioni > App private)
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token_here

# ── Gmail OAuth2 ─────────────────────────────────────────────────────────────
# File JSON delle credenziali OAuth2 scaricato da Google Cloud Console
GMAIL_CREDENTIALS_FILE=credentials.json

# File token generato automaticamente al primo accesso (non modificare)
GMAIL_TOKEN_FILE=token.json

# ── Comportamento sync ───────────────────────────────────────────────────────
# Secondi tra un ciclo di polling e il successivo
POLL_INTERVAL_SECONDS=60

# Numero massimo di messaggi da elaborare per ciclo (primo avvio)
MAX_MESSAGES_PER_POLL=50

# File JSON per tracciare i messaggi già processati
STATE_FILE=processed_messages.json
