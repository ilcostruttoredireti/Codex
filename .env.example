# ── HubSpot ───────────────────────────────────────────────────────────────────
# Private App access token (Settings → Integrations → Private Apps)
# Required scopes: crm.objects.contacts.read, crm.objects.contacts.write,
#                  crm.objects.notes.write
HUBSPOT_ACCESS_TOKEN=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Gmail ─────────────────────────────────────────────────────────────────────
# Path to the OAuth2 client-secret JSON downloaded from Google Cloud Console
# (APIs & Services → Credentials → OAuth 2.0 → Desktop App → Download JSON)
# Rename the downloaded file to credentials.json and place it next to sync.py
# GOOGLE_CREDENTIALS_FILE=credentials.json   # implicit default

# ── Behaviour ─────────────────────────────────────────────────────────────────
# How often to poll for new emails (seconds). Default: 60
POLL_INTERVAL_SECONDS=60

# Maximum messages to scan on first run. Default: 50
MAX_INBOX_SCAN=50

# Comma-separated internal/relay addresses — never synced as contacts
INTERNAL_SENDERS=redazione@latestata.it

# Path for the processed-message-ID state file. Default: state.json
STATE_FILE=state.json
