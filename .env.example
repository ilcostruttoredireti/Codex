# ── HubSpot ───────────────────────────────────────────────────────────────────
# Create a Private App in HubSpot → Settings → Integrations → Private Apps
# Required scopes: crm.objects.contacts.read, crm.objects.contacts.write,
#                  crm.objects.notes.read, crm.objects.notes.write
HUBSPOT_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Gmail / Google OAuth ──────────────────────────────────────────────────────
# Download from Google Cloud Console → APIs & Services → Credentials
# (OAuth 2.0 Client ID → Desktop App → Download JSON)
GMAIL_CREDENTIALS_FILE=credentials.json

# Cached OAuth token (auto-generated after first login)
GMAIL_TOKEN_FILE=token.pickle

# ── Sync behaviour ────────────────────────────────────────────────────────────
# Path to the incremental-sync state file (auto-created)
STATE_FILE=sync_state.json

# How often to poll Gmail in daemon mode (seconds)
POLL_INTERVAL_SECONDS=60

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
