# ── Gmail ──────────────────────────────────────────────────────────────────────
# Path to the OAuth2 client-secrets JSON downloaded from Google Cloud Console
GMAIL_CREDENTIALS_FILE=credentials.json
# Path where the OAuth2 access/refresh token is cached after first login
GMAIL_TOKEN_FILE=token.json

# ── HubSpot ────────────────────────────────────────────────────────────────────
# Private App token (Settings → Integrations → Private Apps)
# Required scopes: crm.objects.contacts.read, crm.objects.contacts.write,
#                  crm.schemas.contacts.read, engagements.write
HUBSPOT_API_KEY=pat-eu1-xxxxxxxxxxxxxxxxxxxx

# ── Sync behaviour ─────────────────────────────────────────────────────────────
# How often (seconds) to poll Gmail for new messages (default: 60)
POLL_INTERVAL_SECONDS=60
# Path to the file that stores the last-processed Gmail history id
STATE_FILE=sync_state.json
