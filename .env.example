# HubSpot Private App token
# Genera da: Settings > Integrations > Private Apps
HUBSPOT_API_KEY=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Path al file JSON delle credenziali OAuth2 scaricato da Google Cloud Console
GMAIL_CREDENTIALS_FILE=gmail_credentials.json

# Intervallo di polling in secondi (default: 60)
POLL_INTERVAL_SECONDS=60
