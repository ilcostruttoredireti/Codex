# ── HubSpot ───────────────────────────────────────────────────────────
# Private App token (Settings → Integrations → Private Apps)
# Required scopes: crm.objects.contacts.read, crm.objects.contacts.write,
#                  crm.objects.notes.write
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Gmail OAuth2 ──────────────────────────────────────────────────────
# Download from Google Cloud Console → APIs & Services → Credentials
# Required scope: https://www.googleapis.com/auth/gmail.readonly
GMAIL_CREDENTIALS_PATH=credentials.json

# Generated automatically on first run — do not share
GMAIL_TOKEN_PATH=token.json

# ── Sync settings ─────────────────────────────────────────────────────
# How often (in seconds) to poll Gmail for new messages
POLL_INTERVAL_SECONDS=60

# File used to persist the Gmail history cursor and sync log
STATE_FILE=sync_state.json
