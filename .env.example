# HubSpot Private App token (Settings → Integrations → Private Apps)
HUBSPOT_API_TOKEN=your_hubspot_private_app_token

# Path to Gmail OAuth2 token file (generated on first run via browser flow)
GMAIL_TOKEN_FILE=token.json

# Path to Google OAuth2 credentials JSON (from Google Cloud Console)
GMAIL_CREDENTIALS_FILE=credentials.json

# How many days back to scan inbox (default: 1)
SEARCH_DAYS=1
