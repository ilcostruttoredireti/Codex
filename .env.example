# HubSpot private app token (Settings → Integrations → Private Apps)
HUBSPOT_ACCESS_TOKEN=your_hubspot_token_here

# Gmail OAuth2 credentials JSON downloaded from Google Cloud Console
GMAIL_CREDENTIALS_PATH=credentials.json

# Cached OAuth token (auto-generated on first run)
GMAIL_TOKEN_PATH=token.json

# How many days back to scan on the very first run
SYNC_LOOKBACK_DAYS=7

# File that persists the last-run timestamp between runs
STATE_FILE=.sync_state

# Comma-separated domain fragments to skip (in addition to built-in no-reply/noreply filter)
# Example: skip all google and facebook automated mail
SKIP_DOMAINS=google.com,facebookmail.com,linkedin.com
