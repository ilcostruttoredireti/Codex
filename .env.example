# HubSpot Private App token
# Create one at: Settings → Integrations → Private Apps
# Required scopes: crm.objects.contacts.read, crm.objects.contacts.write, crm.objects.notes.write
HUBSPOT_API_KEY=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional: polling interval in seconds (default: 60)
POLL_INTERVAL=60
