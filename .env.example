# Gmail OAuth2 access token (scope: gmail.readonly)
GMAIL_ACCESS_TOKEN=your_gmail_oauth_access_token

# HubSpot private app token (scope: crm.objects.contacts.read/write, crm.objects.notes.write)
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token

# How often to poll Gmail (seconds)
POLL_INTERVAL_SECONDS=60

# How far back to look for emails on each cycle (minutes)
LOOKBACK_MINUTES=5

# File used to track already-processed thread IDs
STATE_FILE=.sync_state.json
