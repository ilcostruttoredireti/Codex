# ── HubSpot ────────────────────────────────────────────────────────────────
# Private App token from HubSpot → Settings → Integrations → Private Apps
HUBSPOT_API_KEY=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional: Timeline Event integration (requires a HubSpot App + Event Template)
HUBSPOT_TIMELINE_APP_ID=
HUBSPOT_TIMELINE_TEMPLATE_ID=

# ── Gmail OAuth ────────────────────────────────────────────────────────────
# Path to the OAuth 2.0 client credentials JSON downloaded from Google Cloud Console
GMAIL_CREDENTIALS_FILE=credentials.json
# Path where the access/refresh token will be stored after first login
GMAIL_TOKEN_FILE=token.json

# ── Sync behaviour ─────────────────────────────────────────────────────────
# Polling interval in seconds (default 60)
POLL_INTERVAL_SECONDS=60

# Skip contacts from free webmail / noreply domains (true/false)
IGNORE_FREE_EMAIL=true
