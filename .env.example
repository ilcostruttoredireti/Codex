# HubSpot Private App access token
# Crea un'app privata su: https://app.hubspot.com/private-apps
HUBSPOT_API_KEY=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Percorso al file credentials.json scaricato da Google Cloud Console
# (API & Services → OAuth 2.0 Client IDs → Desktop App → Download JSON)
GMAIL_CREDENTIALS_FILE=credentials.json

# Token OAuth2 generato da auth.py (creato automaticamente)
GMAIL_TOKEN_FILE=token.json
