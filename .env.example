# HubSpot Private App Token
# https://developers.hubspot.com/docs/api/private-apps
HUBSPOT_ACCESS_TOKEN=pat-xx-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Path to Gmail OAuth2 credentials JSON (from Google Cloud Console)
GMAIL_CREDENTIALS_FILE=credentials.json

# Path where the Gmail OAuth2 token is cached after first login
GMAIL_TOKEN_FILE=gmail_token.json

# Path to the sync state file (tracks processed thread IDs)
STATE_FILE=sync_state.json
