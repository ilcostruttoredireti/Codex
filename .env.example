# HubSpot Private App token (Settings → Integrations → Private Apps)
HUBSPOT_API_KEY=your_hubspot_private_app_token

# Path to OAuth2 credentials JSON downloaded from Google Cloud Console
GMAIL_CREDENTIALS_FILE=gmail_credentials.json

# Path where the OAuth token will be saved after first login
GMAIL_TOKEN_FILE=gmail_token.json

# Polling interval in seconds (default: 60)
POLL_INTERVAL_SECONDS=60

# Comma-separated domains to skip (no contact created for these senders)
SKIP_DOMAINS=gmail.com,googlemail.com,noreply.com

# File used to persist last processed Gmail historyId
STATE_FILE=sync_state.json
