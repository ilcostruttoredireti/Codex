# ── HubSpot ────────────────────────────────────────────────────────────────
# Private App access token from https://app.hubspot.com/private-apps
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token_here

# ── Gmail OAuth ─────────────────────────────────────────────────────────────
# Path to the OAuth 2.0 client-secret file downloaded from Google Cloud Console
# (APIs & Services → Credentials → Desktop app)
GMAIL_CREDENTIALS_FILE=credentials.json

# Where the refreshable OAuth token is cached after first login
GMAIL_TOKEN_FILE=token.json

# ── Sync tuning ─────────────────────────────────────────────────────────────
# How often to poll Gmail for new messages (seconds)
POLL_INTERVAL_SECONDS=60

# How many inbox messages to process on the very first run
INITIAL_FETCH_LIMIT=50

# File used to persist sync state between runs
PROCESSED_IDS_FILE=.processed_ids.json
