# HubSpot Private App Token
# Crea su: HubSpot → Impostazioni → Integrazioni → App private
HUBSPOT_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Intervallo di polling in secondi (default: 60)
POLL_INTERVAL=60

# Quante email controllare per ciclo (default: 20)
GMAIL_BATCH_SIZE=20

# Domini da ignorare (es. noreply, newsletter) - separati da virgola
IGNORED_DOMAINS=noreply.com,mailchimp.com,newsletter.com,mailer.com

# File per salvare lo stato di sincronizzazione
STATE_FILE=sync_state.json
