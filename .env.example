# Gmail OAuth2 credentials (download from Google Cloud Console → APIs & Services → Credentials)
GMAIL_CREDENTIALS_FILE=credentials.json

# Auto-created on first run after browser OAuth consent
GMAIL_TOKEN_FILE=token.json

# HubSpot private app token (Settings → Integrations → Private Apps)
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token_here

# Gmail search query — default covers last 24 h of inbound mail
GMAIL_QUERY=in:inbox newer_than:1d -from:me

# Max emails fetched per run
GMAIL_MAX_RESULTS=50

# JSON file that tracks already-processed message IDs (prevents duplicates across runs)
STATE_FILE=.sync_state.json
