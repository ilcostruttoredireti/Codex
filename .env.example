# Gmail OAuth2 (scarica da Google Cloud Console → Credenziali → OAuth 2.0 Client ID)
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# HubSpot Private App Token (HubSpot → Impostazioni → Integrazioni → App Private)
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxxxxxxxxxxxxxx

# Intervallo polling in secondi (default: 60)
POLL_INTERVAL_SECONDS=60

# Etichetta Gmail da monitorare (default: INBOX)
GMAIL_LABEL=INBOX

# Indirizzo email dell'account Gmail monitorato (usato per escludere auto-messaggi)
GMAIL_OWNER_EMAIL=tuo@gmail.com
