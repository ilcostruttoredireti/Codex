# ── Gmail → HubSpot Sync — environment variables ──────────────────────────────

# HubSpot private-app access token
# Create one at: Settings → Integrations → Private Apps
# Required scopes: crm.objects.contacts.read, crm.objects.contacts.write,
#                  crm.schemas.contacts.read, crm.schemas.contacts.write
HUBSPOT_TOKEN=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Your own Gmail address (emails from yourself will be skipped)
OWN_EMAIL=your@gmail.com

# Daemon mode: seconds between each inbox scan (default: 300 = 5 minutes)
POLL_INTERVAL_SEC=300

# Logging verbosity: DEBUG | INFO | WARNING
LOG_LEVEL=INFO
