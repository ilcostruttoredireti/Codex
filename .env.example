# Gmail OAuth2 credentials (download from Google Cloud Console)
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# HubSpot Private App Token
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token

# Sync settings
POLL_INTERVAL_SECONDS=300
DAYS_LOOKBACK=7
# Emails to skip (comma-separated)
SKIP_SENDERS=mailer-daemon@googlemail.com,no-reply@accounts.google.com,analytics-noreply@google.com,notification@priority.facebookmail.com,posta-certificata@legalmail.it
# Own email addresses (comma-separated) - senders to ignore
OWN_EMAILS=pubblica.latestata@gmail.com,cristian.mameli.editore@gmail.com,cristian.mameli@gmail.com,redazione@latestata.it
