# ── Gmail OAuth ──────────────────────────────────────────────────────
# Path to the credentials JSON file downloaded from Google Cloud Console.
# Must have the Gmail API enabled and OAuth consent screen configured.
GMAIL_CREDENTIALS_FILE=credentials.json

# Token file (auto-created after first OAuth login).
GMAIL_TOKEN_FILE=token.json

# ── HubSpot ──────────────────────────────────────────────────────────
# Private App token from HubSpot → Settings → Integrations → Private Apps.
# Required scopes: crm.objects.contacts.read, crm.objects.contacts.write
HUBSPOT_API_KEY=your_hubspot_private_app_token

# ── Sync behaviour ───────────────────────────────────────────────────
# How often to check for new Gmail messages (seconds).
POLL_INTERVAL_SECONDS=60

# File used to store the last-processed Gmail historyId.
STATE_FILE=sync_state.json
