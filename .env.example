# ──────────────────────────────────────────
# Gmail → HubSpot Sync — Environment Variables
# ──────────────────────────────────────────

# HubSpot Private App access token
# Create one at: HubSpot → Settings → Integrations → Private Apps
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token_here

# Path to the OAuth 2.0 credentials JSON downloaded from Google Cloud Console
# Scopes needed: gmail.readonly, gmail.labels, gmail.modify
GMAIL_CREDENTIALS_FILE=credentials.json

# Cached OAuth token (auto-generated on first run)
GMAIL_TOKEN_FILE=token.json

# How often to check for new emails (seconds)
POLL_INTERVAL_SECONDS=60

# Max emails to process per cycle
MAX_EMAILS_PER_CYCLE=50

# Value stored in HubSpot "Lead Source" field
CONTACT_SOURCE=Gmail
