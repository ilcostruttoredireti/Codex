# HubSpot Private App token
# Generate at: Settings → Integrations → Private Apps
HUBSPOT_API_KEY=your_hubspot_private_app_token

# Path to Google OAuth credentials JSON (from Google Cloud Console)
GMAIL_CREDENTIALS_FILE=credentials.json

# Path to stored Gmail OAuth token (auto-generated on first run)
GMAIL_TOKEN_FILE=token.json

# File to track processed message IDs (prevents reprocessing)
STATE_FILE=.gmail_sync_state.json

# How often to poll Gmail for new messages (seconds)
POLL_INTERVAL_SECONDS=60
