# HubSpot Private App access token (required)
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxxxxxxxxxxxxxx

# Path to Gmail OAuth2 credentials JSON downloaded from Google Cloud Console
GMAIL_CREDENTIALS_FILE=credentials.json

# Path where the OAuth2 token is stored after first login
GMAIL_TOKEN_FILE=token.json

# How many days back to scan on the very first run (default: 1)
LOOKBACK_DAYS=1

# File that tracks which messages have already been processed
STATE_FILE=.sync_state.json
