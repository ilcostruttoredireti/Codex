# HubSpot Private App token (required)
# Create at: HubSpot → Settings → Integrations → Private Apps
# Required scopes: crm.objects.contacts.read, crm.objects.contacts.write
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides
POLL_INTERVAL=300         # seconds between Gmail polls (default: 300)
STATE_FILE=processed_ids.json
LOG_FILE=sync.log
