# HubSpot private app token (requires contacts read/write scope)
HUBSPOT_TOKEN=your_hubspot_private_app_token

# Path to the OAuth2 credentials JSON downloaded from Google Cloud Console
GMAIL_CREDENTIALS_FILE=credentials.json

# Path where the OAuth2 token will be stored after first login
GMAIL_TOKEN_FILE=token.json

# How many hours back to scan for new emails (default: 24)
LOOKBACK_HOURS=24
