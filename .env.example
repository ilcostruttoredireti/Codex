# ── Google / Gmail ────────────────────────────────────────────────────────────
# Scarica il file JSON da Google Cloud Console → API & Services → Credentials
GOOGLE_CREDENTIALS_FILE=credentials.json

# Generato automaticamente al primo accesso OAuth
GOOGLE_TOKEN_FILE=token.json

# ── HubSpot ───────────────────────────────────────────────────────────────────
# Crea un Private App in HubSpot → Settings → Integrations → Private Apps
# Scope minimi richiesti: crm.objects.contacts.read, crm.objects.contacts.write
#                         crm.objects.notes.write
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Comportamento ────────────────────────────────────────────────────────────
# Secondi tra un polling e il successivo (default: 60)
POLL_INTERVAL_SECONDS=60

# Quanti messaggi Gmail controllare per ciclo (max 50)
MAX_MESSAGES_PER_POLL=50

# File di stato locale (traccia i messaggi già processati)
STATE_FILE=sync_state.json
