# ── HubSpot ──────────────────────────────────────────────────────────────────
# Chiave API privata HubSpot (Settings → Integrations → Private Apps)
HUBSPOT_API_KEY=pat-eu1-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Gmail ─────────────────────────────────────────────────────────────────────
# Percorso al file credentials.json scaricato da Google Cloud Console
# (OAuth 2.0 Client ID → Desktop app)
GMAIL_CREDENTIALS_FILE=credentials.json

# Percorso dove salvare/leggere il token OAuth (auto-generato al primo avvio)
GMAIL_TOKEN_FILE=token.json

# ── Opzionale ─────────────────────────────────────────────────────────────────
# Secondi tra un ciclo e l'altro (0 = esegui una volta sola e termina)
SYNC_INTERVAL_SECONDS=0

# Percorso file di stato locale (traccia messaggi già processati via etichette Gmail)
STATE_FILE=state.json
