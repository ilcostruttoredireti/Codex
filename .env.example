# ── Obbligatori ───────────────────────────────────────────────────────────────

# HubSpot Private App token (Settings → Integrations → Private Apps)
HUBSPOT_API_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Il tuo indirizzo email (i messaggi inviati da questo indirizzo vengono ignorati)
MY_EMAIL=tu@tuazienda.com

# ── Gmail OAuth ───────────────────────────────────────────────────────────────

# Percorso al file JSON scaricato da Google Cloud Console
# (API & Services → Credentials → OAuth 2.0 Client ID → tipo Desktop)
GMAIL_CREDENTIALS_FILE=credentials.json

# File dove viene salvato il token OAuth dopo il primo login (auto-generato)
GMAIL_TOKEN_FILE=token.json

# ── Comportamento ─────────────────────────────────────────────────────────────

# Secondi tra un ciclo di polling e il successivo (default: 60)
POLL_INTERVAL_SECONDS=60

# Crea note HubSpot per ogni email elaborata: true | false (default: true)
ENABLE_NOTES=true

# Nome della property HubSpot usata per registrare la fonte "Gmail"
# Creala in HubSpot: Settings → Properties → Create property (tipo: Single-line text)
LEAD_SOURCE_PROPERTY=lead_source

# File dove viene salvato lo stato del polling tra un'esecuzione e l'altra
STATE_FILE=.sync_state.json
