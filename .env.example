# HubSpot private app token
# Crea un Private App su: Settings → Integrations → Private Apps
# Scope richiesti: crm.objects.contacts.read, crm.objects.contacts.write
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token_here

# Intervallo di polling Gmail in secondi (default: 60)
POLL_INTERVAL_SECONDS=60

# File per tracciare l'ultimo messaggio processato
STATE_FILE=.sync_state.json

# Dominio/email da ignorare (es. notifiche automatiche)
# Lista separata da virgole
IGNORE_DOMAINS=noreply.com,no-reply.com,mailer-daemon.org
IGNORE_EMAILS=

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
