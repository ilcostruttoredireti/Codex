# HubSpot Private App Token
# Generate at: https://app.hubspot.com/private-apps
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token_here

# Gmail OAuth2 credentials file path (from Google Cloud Console)
GOOGLE_CREDENTIALS_FILE=credentials.json

# Gmail OAuth2 token file (auto-generated on first run)
GOOGLE_TOKEN_FILE=token.json

# Polling interval in seconds (default: 60)
POLL_INTERVAL_SECONDS=60

# State file to track processed emails
STATE_FILE=sync_state.json

# Comma-separated list of personal email domains to skip for company extraction
SKIP_DOMAINS=gmail.com,yahoo.com,hotmail.com,outlook.com,icloud.com,protonmail.com,live.com,aol.com,mail.com

# Gmail label/query filter (default: INBOX, unread emails)
GMAIL_QUERY=in:inbox is:unread
