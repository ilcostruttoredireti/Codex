# Google OAuth credentials (download from Google Cloud Console)
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# HubSpot Private App token
# Create at: HubSpot > Settings > Integrations > Private Apps
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token_here

# How often to poll Gmail for new emails (seconds)
POLL_INTERVAL_SECONDS=60

# Gmail label/query to monitor (default: all inbox emails)
# Examples: "label:inbox", "label:inbox is:unread", "in:inbox newer_than:1d"
GMAIL_QUERY=label:inbox is:unread

# Optional: HubSpot owner ID to assign new contacts to
# HUBSPOT_OWNER_ID=12345678

# Optional: log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
