# ── HubSpot ──────────────────────────────────────────────────────────────────
# Crea una Private App su: Impostazioni → Integrazioni → App private
# Scopes minimi richiesti: crm.objects.contacts.read, crm.objects.contacts.write
#                          crm.objects.notes.read,    crm.objects.notes.write
HUBSPOT_API_KEY=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Gmail OAuth ───────────────────────────────────────────────────────────────
# Scarica credentials.json da Google Cloud Console:
# APIs & Services → Credenziali → Crea credenziali → ID client OAuth 2.0
# Tipo applicazione: Desktop app
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# ── Polling ───────────────────────────────────────────────────────────────────
# Secondi di attesa tra un ciclo e l'altro (default: 60)
POLL_INTERVAL=60

# ── Log ───────────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
