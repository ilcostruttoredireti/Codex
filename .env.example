# Google OAuth2 credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8080

# HubSpot Private App Token (from HubSpot Settings > Integrations > Private Apps)
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token

# Optional: polling interval in seconds (default 60)
POLL_INTERVAL_SECONDS=60

# Optional: path to store processed state (default: .sync_state.json)
STATE_FILE_PATH=.sync_state.json

# Optional: path to store Google OAuth tokens (default: .google_token.json)
GOOGLE_TOKEN_PATH=.google_token.json
