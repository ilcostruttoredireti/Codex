# Gmail OAuth2 credentials (download from Google Cloud Console)
GMAIL_CREDENTIALS_FILE=credentials.json
# After first run, token is cached here automatically
GMAIL_TOKEN_FILE=token.json

# HubSpot private app token
# Create at: HubSpot > Settings > Integrations > Private Apps
HUBSPOT_API_KEY=your_hubspot_private_app_token_here

# Polling interval in seconds (default: 60)
POLL_INTERVAL_SECONDS=60

# Optional: Gmail label/query filter (default: all inbox)
# GMAIL_QUERY=is:unread in:inbox
GMAIL_QUERY=in:inbox
