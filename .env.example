# ── HubSpot ──────────────────────────────────────────────────────────────────
# Token Private App da: HubSpot → Impostazioni → Integrazioni → App private
# Permessi minimi richiesti: crm.objects.contacts.read / write,
#                             crm.objects.notes.read / write,
#                             crm.objects.emails.read / write
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token_here

# ── Gmail OAuth ───────────────────────────────────────────────────────────────
# Scarica credentials.json da Google Cloud Console:
#   APIs & Services → Credentials → OAuth 2.0 Client IDs → Desktop app → Download JSON
GMAIL_CREDENTIALS_FILE=credentials.json

# Generato automaticamente al primo avvio (non modificare)
GMAIL_TOKEN_FILE=token.json

# ── Comportamento sync ────────────────────────────────────────────────────────
# Secondi tra un controllo e il successivo (default: 60)
POLL_INTERVAL_SECONDS=60

# Nome label Gmail applicata ai messaggi già sincronizzati
GMAIL_PROCESSED_LABEL=HubSpot-Synced
