# ── HubSpot ───────────────────────────────────────────────────────────────────
# Token privato dall'app HubSpot (Settings → Integrations → Private Apps)
HUBSPOT_ACCESS_TOKEN=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Gmail OAuth2 ──────────────────────────────────────────────────────────────
# Scarica da Google Cloud Console → API & Services → Credentials → OAuth 2.0
GMAIL_CREDENTIALS_FILE=credentials.json
# Generato automaticamente al primo avvio
GMAIL_TOKEN_FILE=token.json

# ── Comportamento sync ────────────────────────────────────────────────────────
# Intervallo di polling in secondi (default: 120)
POLL_INTERVAL_SECONDS=120
# Numero massimo di messaggi per passata (default: 100)
MAX_RESULTS_PER_RUN=100
# File di stato locale (default: processed_emails.json)
STATE_FILE=processed_emails.json
