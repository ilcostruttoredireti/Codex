# ── HubSpot ──────────────────────────────────────────────────────────
# Private App Access Token (Settings → Integrations → Private Apps)
HUBSPOT_ACCESS_TOKEN=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Gmail OAuth ──────────────────────────────────────────────────────
# Path to OAuth 2.0 credentials JSON downloaded from Google Cloud Console
GMAIL_CREDENTIALS_FILE=credentials.json

# Path where the OAuth token is cached after first login (auto-created)
GMAIL_TOKEN_FILE=token.json

# ── Runtime ──────────────────────────────────────────────────────────
# JSON file that tracks already-processed Gmail message IDs
STATE_FILE=sync_state.json

# Polling interval in seconds (continuous mode only)
POLL_INTERVAL_SECONDS=60
