# ── Gmail ────────────────────────────────────────────────────────────
# Path to the OAuth2 client-secrets JSON downloaded from Google Cloud Console.
# (APIs & Services → Credentials → OAuth 2.0 Client IDs → Download JSON)
GMAIL_CREDENTIALS_FILE=credentials/credentials.json

# Where the script caches the refresh token after first-time login.
GMAIL_TOKEN_FILE=credentials/token.json

# The Gmail account to monitor. "me" resolves to the authenticated user.
GMAIL_USER_ID=me

# ── HubSpot ──────────────────────────────────────────────────────────
# Private App token from HubSpot → Settings → Integrations → Private Apps.
# Required scopes: crm.objects.contacts.read, crm.objects.contacts.write,
#                  crm.objects.notes.write
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token_here

# ── Sync behaviour ───────────────────────────────────────────────────
# How often (in seconds) to check Gmail for new messages.
POLL_INTERVAL=30
