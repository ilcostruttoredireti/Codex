# HubSpot Private App Token
# Crea un Private App su: Settings → Integrations → Private Apps
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token_here

# Gmail OAuth2 - scarica credentials.json da Google Cloud Console
# (APIs & Services → Credentials → OAuth 2.0 Client IDs)
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# Intervallo di polling in secondi (default: 60)
POLL_INTERVAL_SECONDS=60

# Domini da ignorare (no-reply, notifiche automatiche)
IGNORED_DOMAINS=noreply.com,notifications.google.com,mailer-daemon.google.com

# File di stato per tracciare le email già processate
STATE_FILE=sync_state.json
