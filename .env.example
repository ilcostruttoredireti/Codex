# ── Gmail OAuth2 ──────────────────────────────────────────────────────────────
# Scarica il file credentials.json dalla Google Cloud Console:
# https://console.cloud.google.com → API & Services → Credentials → OAuth 2.0
# Abilita l'API Gmail nel progetto.
GMAIL_CREDENTIALS_FILE=credentials.json

# ── HubSpot Private App ───────────────────────────────────────────────────────
# Crea una Private App in HubSpot:
# Settings → Integrations → Private Apps → Create
# Scope necessari: crm.objects.contacts.read, crm.objects.contacts.write
HUBSPOT_API_KEY=your_hubspot_private_app_token_here
