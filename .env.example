# HubSpot private-app token (Contacts read + write scope required)
HUBSPOT_ACCESS_TOKEN=your_hubspot_token_here

# Path to the Google OAuth2 credentials JSON file downloaded from Google Cloud Console
GMAIL_CREDENTIALS_JSON=credentials.json

# Path where the OAuth2 token will be stored/refreshed automatically
GMAIL_TOKEN_JSON=token.json

# How many days back to scan the Gmail inbox on each run (default: 1)
SYNC_LOOKBACK_DAYS=1
