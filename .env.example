# HubSpot Private App Token
# Create one at: Settings → Integrations → Private Apps
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token_here

# Gmail OAuth2 credentials (download from Google Cloud Console)
# Path to the credentials JSON file downloaded from Google Cloud Console
GMAIL_CREDENTIALS_FILE=credentials/gmail_credentials.json

# Path where the OAuth token will be stored after first authentication
GMAIL_TOKEN_FILE=credentials/gmail_token.json

# Gmail user to monitor (use 'me' for the authenticated user)
GMAIL_USER=me

# Polling interval in seconds (default: 60)
POLL_INTERVAL=60

# Path to store sync state (last processed history ID, etc.)
STATE_FILE=state/sync_state.json

# Optional: log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
