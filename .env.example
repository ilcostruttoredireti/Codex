# Gmail OAuth2 – scarica credentials.json da Google Cloud Console
# https://console.cloud.google.com/ → APIs & Services → Credentials → OAuth 2.0 Client ID
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# HubSpot Private App Token
# https://app.hubspot.com/private-apps → Crea app privata → scopes: crm.objects.contacts.write + crm.objects.contacts.read
HUBSPOT_ACCESS_TOKEN=your-hubspot-private-app-token

# Intervallo di polling in secondi (default: 60)
POLL_INTERVAL_SECONDS=60

# Label Gmail da monitorare (default: INBOX)
GMAIL_LABEL=INBOX

# ID dell'ultima email processata (gestito automaticamente)
LAST_HISTORY_ID_FILE=.last_history_id
