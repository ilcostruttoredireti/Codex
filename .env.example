# HubSpot Private App token (Settings → Integrations → Private Apps)
HUBSPOT_API_KEY=pat-na1-xxxxxxxxxxxxxxxxxxxx

# Gmail OAuth credentials file (downloaded from Google Cloud Console)
GMAIL_CREDENTIALS_FILE=credentials.json

# Gmail OAuth token (auto-generated on first run)
GMAIL_TOKEN_FILE=token.json

# How often to poll Gmail (seconds). Default: 120
POLL_INTERVAL_SECONDS=120

# Where to persist processed message IDs and last history ID
STATE_FILE=sync_state.json

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
