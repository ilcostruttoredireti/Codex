# ── Gmail ────────────────────────────────────────────────────────────────────
# Path to the OAuth2 client_secret JSON downloaded from Google Cloud Console.
# Enable the Gmail API and create an OAuth 2.0 credential (Desktop app type).
GMAIL_CREDENTIALS_FILE=credentials.json

# Where the script stores the refreshed OAuth token between runs.
GMAIL_TOKEN_FILE=token.json

# Your own Gmail address.  Messages from this address are skipped.
SELF_EMAIL=you@gmail.com

# ── HubSpot ───────────────────────────────────────────────────────────────────
# Private-app access token from HubSpot → Settings → Integrations → Private Apps.
# Required scopes: crm.objects.contacts.read, crm.objects.contacts.write,
#                  crm.objects.notes.write
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Runtime ───────────────────────────────────────────────────────────────────
# How often (seconds) to poll Gmail for new messages.
POLL_INTERVAL_SECONDS=60

# File used to persist the Gmail history ID between restarts.
STATE_FILE=state.json
