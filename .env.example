# HubSpot Private App token
# Crea da: HubSpot → Impostazioni → Integrazioni → App private
HUBSPOT_TOKEN=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Percorso al file JSON delle credenziali Google OAuth2
# Scarica da: Google Cloud Console → API & Services → Credentials
GOOGLE_CREDENTIALS_FILE=credentials.json
