# Gmail OAuth2 credentials (download from Google Cloud Console)
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.pickle

# HubSpot Private App Token
HUBSPOT_API_KEY=your_hubspot_private_app_token_here

# How often to check for new emails (seconds). Default: 300 (5 minutes)
POLL_INTERVAL_SECONDS=300

# State file to track processed threads
STATE_FILE=sync_state.json
