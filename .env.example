# Gmail OAuth2 access token
# Ottienilo da: https://developers.google.com/oauthplayground
# Scope richiesto: https://www.googleapis.com/auth/gmail.readonly
GMAIL_ACCESS_TOKEN=ya29.xxxx

# HubSpot Private App token
# Crea una Private App in: Impostazioni → Integrazioni → App private
# Scope richiesti: crm.objects.contacts.read, crm.objects.contacts.write
HUBSPOT_ACCESS_TOKEN=pat-eu1-xxxx

# Opzionali
POLL_INTERVAL_SECONDS=300
STATE_FILE=gmail_hubspot_state.json
