# ── Google / Gmail ────────────────────────────────────────────────────────────
# Path to the OAuth 2.0 client credentials JSON downloaded from Google Cloud Console
# (APIs & Services → Credentials → OAuth 2.0 Client IDs → Download JSON)
GOOGLE_CREDENTIALS_FILE=credentials.json

# Where to persist the OAuth token after first login (auto-created)
GOOGLE_TOKEN_FILE=token.json

# ── HubSpot ───────────────────────────────────────────────────────────────────
# Private App access token from HubSpot
# (Settings → Integrations → Private Apps → Create / view token)
# Required scopes: crm.objects.contacts.read  crm.objects.contacts.write
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Sync behaviour ────────────────────────────────────────────────────────────
# How often to poll Gmail for new messages (seconds). Default: 60
POLL_INTERVAL_SECONDS=60

# Where to store the local sync state (historyId + processed message IDs)
STATE_FILE=.sync_state.json
