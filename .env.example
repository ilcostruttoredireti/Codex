# ── Gmail OAuth2 ───────────────────────────────────────────────────────────────
# Scarica da: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
GMAIL_CREDENTIALS_FILE=credentials.json

# File generato automaticamente al primo login OAuth (non committare)
GMAIL_TOKEN_FILE=token.json

# ── HubSpot ────────────────────────────────────────────────────────────────────
# Ottieni da: HubSpot → Impostazioni → Integrazioni → App private → Crea app privata
# Permessi necessari: crm.objects.contacts.read, crm.objects.contacts.write
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Comportamento sync ─────────────────────────────────────────────────────────
# Secondi tra un ciclo e il successivo (default: 60)
POLL_INTERVAL_SECONDS=60

# Quante email controllare per ciclo (max 50, default: 50)
MAX_RESULTS_PER_POLL=50

# Aggiunge una nota di timeline in HubSpot per ogni email ricevuta (default: true)
ENABLE_TIMELINE_NOTES=true

# File di stato per tracciare gli ID già processati
STATE_FILE=state/processed_ids.json
