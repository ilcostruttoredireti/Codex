# HubSpot private app token (Settings → Integrations → Private Apps)
HUBSPOT_API_KEY=your_hubspot_private_app_token_here

# Path to Google OAuth 2.0 credentials JSON (downloaded from Google Cloud Console)
GMAIL_CREDENTIALS_FILE=credentials.json

# Path where the cached OAuth token is stored after first login
GMAIL_TOKEN_FILE=token.json

# How many hours to look back on the very first run (or after history expiry)
LOOKBACK_HOURS=24
