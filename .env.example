# Gmail OAuth credentials (from Google Cloud Console)
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# HubSpot Private App token (from HubSpot Settings > Integrations > Private Apps)
HUBSPOT_ACCESS_TOKEN=your-hubspot-private-app-token

# Polling interval in seconds (default: 60)
POLL_INTERVAL=60

# Path to persist the last-seen message ID across restarts
STATE_FILE=.gmail_sync_state
