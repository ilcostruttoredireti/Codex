# HubSpot Private App token
# Crea un'app privata su: app.hubspot.com → Impostazioni → Integrazioni → App private
# Scope minimi richiesti: crm.objects.contacts.read, crm.objects.contacts.write
HUBSPOT_API_KEY=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Percorso del file credentials.json scaricato da Google Cloud Console
# (progetto con Gmail API abilitata, tipo app "Desktop")
GMAIL_CREDENTIALS_PATH=credentials.json
