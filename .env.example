# Gmail → HubSpot Sync — Environment Variables
# Copy this file to .env and fill in your values

# HubSpot private-app access token
# Create at: HubSpot → Settings → Integrations → Private Apps
# Scopes required: crm.objects.contacts.read, crm.objects.contacts.write
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token_here

# Path to OAuth2 credentials JSON downloaded from Google Cloud Console
# APIs & Services → Credentials → OAuth 2.0 Client IDs → Download JSON
GMAIL_CREDENTIALS_FILE=credentials.json

# Token cache file (auto-created after first login)
GMAIL_TOKEN_FILE=token.json

# Days back to scan on each run (default: 1)
SYNC_DAYS_BACK=1

# Comma-separated email domains to skip (notifications, bots, etc.)
SKIP_DOMAINS=facebookmail.com,googlemail.com,mailer-daemon.google.com

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
