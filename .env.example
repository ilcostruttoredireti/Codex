# ── HubSpot ───────────────────────────────────────────────────────────────────
# Crea un Private App token da: HubSpot → Settings → Integrations → Private Apps
# Scopes richiesti: crm.objects.contacts.read, crm.objects.contacts.write,
#                   crm.objects.notes.write
HUBSPOT_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Gmail ─────────────────────────────────────────────────────────────────────
# Scarica il file OAuth2 da: Google Cloud Console → APIs & Services → Credentials
# → Create Credentials → OAuth client ID → Desktop app → Download JSON
GMAIL_CREDENTIALS_FILE=credentials.json

# File token generato automaticamente dopo il primo login OAuth
GMAIL_TOKEN_FILE=token.json

# ── Comportamento sync ────────────────────────────────────────────────────────
# Intervallo di polling in secondi (default: 60)
POLL_INTERVAL=60

# Numero di messaggi da recuperare al primo avvio (default: 50)
INITIAL_FETCH_LIMIT=50

# File JSON dove viene salvato lo stato tra un ciclo e l'altro
STATE_FILE=sync_state.json
