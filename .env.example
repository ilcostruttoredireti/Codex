# HubSpot private app token
# Crea su: https://app.hubspot.com/private-apps
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token

# Percorso al file credentials.json scaricato da Google Cloud Console
# (OAuth2 Desktop App)
GMAIL_CREDENTIALS_JSON=credentials.json

# Percorso dove verrà salvato il token Gmail (generato al primo avvio)
GMAIL_TOKEN_JSON=token.json

# Quante ore indietro scandire la inbox (default 24)
SYNC_LOOKBACK_HOURS=24
