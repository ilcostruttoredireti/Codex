# ── HubSpot ───────────────────────────────────────────────────────────────────
# Private App token from HubSpot → Settings → Integrations → Private Apps
# Required scopes: crm.objects.contacts.read, crm.objects.contacts.write,
#                  crm.objects.emails.read, crm.objects.emails.write
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Gmail ─────────────────────────────────────────────────────────────────────
# Path to the OAuth2 credentials JSON downloaded from Google Cloud Console
# (APIs & Services → Credentials → OAuth 2.0 Client ID → Download JSON)
GMAIL_CREDENTIALS_FILE=credentials.json

# ── Sync behaviour ────────────────────────────────────────────────────────────
# How often (in minutes) to poll Gmail in continuous mode (default: 5)
SYNC_INTERVAL_MINUTES=5
