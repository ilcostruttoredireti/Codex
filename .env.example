# Gmail API
GMAIL_CREDENTIALS_PATH=credentials.json   # OAuth2 client secret from Google Cloud Console
GMAIL_TOKEN_PATH=token.json               # Saved after first auth flow (auto-created)

# HubSpot
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxxxxxx # Private App access token

# Sync settings
LOOKBACK_HOURS=24                         # How many hours back to scan Gmail
IGNORED_EMAILS=me@example.com            # Comma-separated emails to skip
