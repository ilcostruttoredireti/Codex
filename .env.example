# ── HubSpot ──────────────────────────────────────────────────────────────────
# Private App token (Settings → Integrations → Private Apps → Create)
# Required scopes: crm.objects.contacts.read, crm.objects.contacts.write
HUBSPOT_API_KEY=your_hubspot_private_app_token_here

# ── Gmail ─────────────────────────────────────────────────────────────────────
# Path to the OAuth credentials file downloaded from Google Cloud Console
# (APIs & Services → Credentials → OAuth 2.0 Client ID → Download JSON)
GMAIL_CREDENTIALS_PATH=credentials.json

# Path where the script stores the OAuth token after first login
GMAIL_TOKEN_PATH=token.json

# ── Sync behaviour ────────────────────────────────────────────────────────────
# Polling interval in seconds (default: 60)
POLL_INTERVAL=60
