# Gmail OAuth2 credentials (from Google Cloud Console)
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# HubSpot Private App Token
# Create at: Settings > Integrations > Private Apps
HUBSPOT_API_KEY=pat-xx-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Polling interval in seconds (default: 60)
POLL_INTERVAL=60

# Path to store last processed Gmail history ID
STATE_FILE=.gmail_state.json

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
