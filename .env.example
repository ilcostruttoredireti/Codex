# HubSpot private app token — create one at:
# https://app.hubspot.com/private-apps/<your-portal-id>
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Path to the Google OAuth credentials file downloaded from Google Cloud Console
GOOGLE_CREDENTIALS=credentials.json

# Path where the OAuth token is cached after the first login
GOOGLE_TOKEN=token.json

# How many hours back to scan for new inbox emails (default: 24)
SYNC_HOURS=24
