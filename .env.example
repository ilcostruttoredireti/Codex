# ── HubSpot ──────────────────────────────────────────────────────────────────
# Private App token (Settings → Integrations → Private Apps)
HUBSPOT_API_KEY=your_hubspot_private_app_token

# ── Gmail OAuth ───────────────────────────────────────────────────────────────
# Path to the credentials.json downloaded from Google Cloud Console
# (APIs & Services → Credentials → OAuth 2.0 Client IDs → Desktop app)
GMAIL_CREDENTIALS_FILE=credentials.json

# Token cache file written automatically after first OAuth login
GMAIL_TOKEN_FILE=token.json

# ── Sync behaviour ────────────────────────────────────────────────────────────
# How often (in seconds) to poll Gmail for new messages
POLL_INTERVAL_SECONDS=60

# File used to persist processed message IDs and the current Gmail historyId
STATE_FILE=state.json

# Comma-separated list of personal email domains to skip company detection for
IGNORED_DOMAINS=gmail.com,yahoo.com,hotmail.com,outlook.com,live.com,icloud.com,protonmail.com
