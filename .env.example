# ── Gmail ──────────────────────────────────────────────────────────────────
# Scarica da: Google Cloud Console → API & Services → Credentials → OAuth 2.0
GMAIL_CREDENTIALS_FILE=credentials.json

# Token OAuth2 salvato automaticamente dopo il primo accesso
GMAIL_TOKEN_FILE=token.json

# ── HubSpot ────────────────────────────────────────────────────────────────
# Crea un Private App in: HubSpot → Settings → Integrations → Private Apps
# Scopes minimi richiesti: crm.objects.contacts.write, crm.objects.contacts.read,
#                          crm.objects.notes.write
HUBSPOT_ACCESS_TOKEN=pat-xx-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Monitoring ─────────────────────────────────────────────────────────────
# Intervallo di polling in secondi (default: 60)
POLL_INTERVAL_SECONDS=60

# File di stato per salvare history ID e messaggi già processati
STATE_FILE=state.json
