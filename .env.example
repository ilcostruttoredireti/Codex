# ──────────────────────────────────────────────────────────────────────────────
# Gmail → HubSpot Contact Sync — Configurazione
# Copia questo file in .env e compila i valori
# ──────────────────────────────────────────────────────────────────────────────

# Token dell'app privata HubSpot
# Percorso: HubSpot → Impostazioni → Integrazioni → App private → Crea app privata
# Scope minimi necessari:
#   crm.objects.contacts.read
#   crm.objects.contacts.write
#   crm.objects.notes.write   (opzionale, per creare note di attività)
HUBSPOT_ACCESS_TOKEN=pat-eu1-xxxxxxxxxxxxxxxxxxxx

# File JSON delle credenziali OAuth2 Gmail
# Percorso: Google Cloud Console → API e servizi → Credenziali →
#           Crea credenziali → ID client OAuth 2.0 → tipo "App desktop"
# Abilita anche: Gmail API (Libreria → cerca Gmail API → Abilita)
GMAIL_CREDENTIALS_FILE=credentials.json

# File token OAuth (generato automaticamente al primo avvio — non modificare)
GMAIL_TOKEN_FILE=token.json

# Intervallo di polling in secondi (default: 60)
POLL_INTERVAL_SECONDS=60
