# HubSpot Private App Access Token
# Crea un'app privata su: HubSpot → Impostazioni → Integrazioni → App private
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Percorso del file credentials OAuth2 di Gmail
# Scaricalo da: Google Cloud Console → API & Servizi → Credenziali → ID client OAuth 2.0
GMAIL_CREDENTIALS_FILE=credentials.json

# File token (generato automaticamente al primo avvio)
GMAIL_TOKEN_FILE=token.json

# File di stato (tiene traccia dell'ultima email processata)
GMAIL_STATE_FILE=.gmail_state.json

# Intervallo di polling in secondi (default: 60)
POLL_INTERVAL=60

# Livello di log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
