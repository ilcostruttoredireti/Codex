# ── Required ──────────────────────────────────────────────────────────────────
# HubSpot Private App access token
# Scopes needed: crm.objects.contacts.read/write  crm.objects.notes.read/write
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Optional ──────────────────────────────────────────────────────────────────
# Path to the Google OAuth2 credentials JSON (from Google Cloud Console)
GMAIL_CREDENTIALS_FILE=credentials.json

# Path where the OAuth token will be stored after first login
GMAIL_TOKEN_FILE=token.json

# Seconds between inbox polls
POLL_INTERVAL=60

# Path to the JSON file that tracks already-processed message IDs
STATE_FILE=sync_state.json

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
