# Gmail OAuth2 credentials
# Download from Google Cloud Console → APIs & Services → Credentials
GMAIL_CREDENTIALS_PATH=credentials.json

# Path where the OAuth2 token will be stored after first login
GMAIL_TOKEN_PATH=token.json

# HubSpot Private App access token
# Settings → Integrations → Private Apps → Create a private app
# Required scopes: crm.objects.contacts.read, crm.objects.contacts.write
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token_here

# (Optional) HubSpot App ID for timeline events
# Leave blank to skip timeline activity creation
HUBSPOT_APP_ID=
