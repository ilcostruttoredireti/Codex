# ─────────────────────────────────────────────────────────────
#  Gmail → HubSpot Sync — Environment Variables
#  Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────

# ── Gmail OAuth2 ──────────────────────────────────────────────
# Path to the credentials.json downloaded from Google Cloud Console.
# (APIs & Services → Credentials → OAuth 2.0 Client ID → Download JSON)
GMAIL_CREDENTIALS_FILE=credentials.json

# Path where the OAuth token is cached after first login.
GMAIL_TOKEN_FILE=token.json

# ── HubSpot ───────────────────────────────────────────────────
# Private App access token.
# (HubSpot → Settings → Integrations → Private Apps → Create/Select → Access token)
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Sync settings ────────────────────────────────────────────
# How often (seconds) to poll Gmail for new emails. Default: 60
POLL_INTERVAL=60

# JSON file used to store the Gmail historyId between runs. Default: .sync_state.json
STATE_FILE=.sync_state.json

# Comma-separated list of email domains to ignore.
# Add your own company domain(s) here to skip internal senders.
IGNORED_DOMAINS=gmail.com,noreply.com,no-reply.com,mailer-daemon.google.com
