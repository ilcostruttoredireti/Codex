# ─── Gmail OAuth ──────────────────────────────────────────────────────────────
# Path to the OAuth 2.0 client credentials downloaded from Google Cloud Console
# (APIs & Services → Credentials → OAuth 2.0 Client IDs → Download JSON)
GMAIL_CREDENTIALS_FILE=credentials/gmail_credentials.json

# Where the access/refresh token will be persisted after first-run auth
GMAIL_TOKEN_FILE=credentials/gmail_token.json

# ─── HubSpot ──────────────────────────────────────────────────────────────────
# Private App token from HubSpot (Settings → Integrations → Private Apps)
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token_here

# ─── Sync behaviour ───────────────────────────────────────────────────────────
# How often to poll Gmail for new messages (seconds)
POLL_INTERVAL_SECONDS=60

# Comma-separated list of email domains to ignore (personal/consumer mail)
IGNORED_DOMAINS=gmail.com,yahoo.com,hotmail.com,outlook.com,icloud.com,aol.com,live.com,protonmail.com

# Set to "true" to create a HubSpot timeline note for each processed email
CREATE_TIMELINE_ACTIVITY=true

# Set to "true" to add the "Inbound Gmail" tag (stored as custom property)
ADD_INBOUND_TAG=true
