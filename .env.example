# ── Gmail OAuth2 ──────────────────────────────────────────────────────────────
# Download from Google Cloud Console → APIs & Services → Credentials
# Create an OAuth 2.0 Client ID (Desktop app) and save the JSON here.
GMAIL_CREDENTIALS_FILE=credentials.json
# Token file generated on first run (auto-refreshed)
GMAIL_TOKEN_FILE=token.json
# Gmail address to monitor (leave blank to use the authenticated account)
GMAIL_USER_ID=me

# ── HubSpot ───────────────────────────────────────────────────────────────────
# Private App token from HubSpot → Settings → Integrations → Private Apps
HUBSPOT_TOKEN=your_hubspot_private_app_token_here

# ── Sync behaviour ────────────────────────────────────────────────────────────
# Polling interval in seconds (default: 60)
POLL_INTERVAL_SECONDS=60
# File used to persist Gmail history state between runs
STATE_FILE=state.json
# Comma-separated list of domains to ignore (personal email providers)
IGNORED_DOMAINS=gmail.com,yahoo.com,yahoo.it,hotmail.com,hotmail.it,outlook.com,live.com,icloud.com,me.com,protonmail.com,aol.com,libero.it,virgilio.it,tiscali.it
