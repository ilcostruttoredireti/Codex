# ─── Gmail OAuth2 ─────────────────────────────────────────────────────────────
# Download from Google Cloud Console → APIs & Services → Credentials → OAuth 2.0
# https://console.cloud.google.com/apis/credentials
GMAIL_CREDENTIALS_FILE=credentials.json   # path al file OAuth client secret
GMAIL_TOKEN_FILE=token.json               # generato automaticamente al primo login
GMAIL_USER_ID=me                          # "me" = account autenticato

# ─── HubSpot Private App ──────────────────────────────────────────────────────
# HubSpot → Settings → Integrations → Private Apps → Create
# Scopes necessari: crm.objects.contacts.read, crm.objects.contacts.write
HUBSPOT_ACCESS_TOKEN=your_private_app_token_here

# ─── Comportamento sync ───────────────────────────────────────────────────────
POLL_INTERVAL_SECONDS=60          # secondi tra ogni controllo
STATE_FILE=.gmail_sync_state.json # dove salvare l'ultimo historyId Gmail
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR

# ─── Filtri opzionali ─────────────────────────────────────────────────────────
# Lista di domini da ignorare (separati da virgola, senza spazi)
IGNORE_DOMAINS=noreply.github.com,mailer-daemon.google.com
# Se "true" ignora le email inviate da sé stesso
IGNORE_SELF=true
