# ── Gmail OAuth ───────────────────────────────────────────────────────────────
# Download from Google Cloud Console → APIs & Services → Credentials
GMAIL_CREDENTIALS_FILE=credentials.json
# Generated automatically on first run (OAuth flow)
GMAIL_TOKEN_FILE=token.json

# ── HubSpot ───────────────────────────────────────────────────────────────────
# Private App token: HubSpot Settings → Integrations → Private Apps
# Required scopes: crm.objects.contacts.read, crm.objects.contacts.write,
#                  crm.objects.notes.write
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Sync behaviour ────────────────────────────────────────────────────────────
# Your own Gmail address — never added as a HubSpot contact
OWN_EMAIL=you@example.com
# Polling interval in seconds
POLL_INTERVAL_SECONDS=60
# File that persists the Gmail history cursor between restarts
STATE_FILE=sync_state.json
