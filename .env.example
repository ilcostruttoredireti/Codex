# ── Gmail OAuth ───────────────────────────────────────────────────────────────
# Download from Google Cloud Console → APIs & Services → Credentials
# OAuth 2.0 Client ID → Desktop app → download JSON → rename to credentials.json
# The script generates token.json automatically on first run.

# ── HubSpot ───────────────────────────────────────────────────────────────────
# Private App token from HubSpot → Settings → Integrations → Private Apps
# Required scopes: crm.objects.contacts.read, crm.objects.contacts.write,
#                  crm.objects.notes.write
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token_here

# ── Sync behaviour ────────────────────────────────────────────────────────────
# Email address of the Gmail account owner (auto-detected if left empty)
OWNER_EMAIL=

# Seconds between inbox polls (default: 60)
POLL_INTERVAL_SECONDS=60
