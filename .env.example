# HubSpot Private App token
# Create one at: Settings → Integrations → Private Apps
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token_here

# Gmail OAuth2 credentials file (download from Google Cloud Console)
GMAIL_CREDENTIALS_FILE=credentials.json

# Where the OAuth2 token is cached after first login
GMAIL_TOKEN_FILE=token.json

# How often to poll Gmail (seconds)
POLL_INTERVAL_SECONDS=60

# File that stores already-processed Gmail message IDs
PROCESSED_IDS_FILE=processed_ids.json
