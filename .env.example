# ── Gmail ────────────────────────────────────────────────────────────────────
# Percorso al file credentials.json scaricato da Google Cloud Console
GMAIL_CREDENTIALS_FILE=credentials.json

# Percorso dove salvare il token OAuth2 (generato automaticamente al primo avvio)
GMAIL_TOKEN_FILE=token.json

# ── HubSpot ──────────────────────────────────────────────────────────────────
# Token di accesso della tua Private App HubSpot
# Crea una Private App su: Settings → Integrations → Private Apps
# Scopes richiesti: crm.objects.contacts.read, crm.objects.contacts.write,
#                   crm.objects.notes.write
HUBSPOT_ACCESS_TOKEN=your-hubspot-private-app-token

# ── Comportamento ────────────────────────────────────────────────────────────
# Secondi tra un controllo Gmail e il successivo (default: 60)
POLL_INTERVAL_SECONDS=60
