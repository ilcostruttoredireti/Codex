# ── HubSpot ────────────────────────────────────────────────────────────────
# Private App access token from HubSpot → Settings → Integrations → Private Apps
HUBSPOT_ACCESS_TOKEN=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Gmail ──────────────────────────────────────────────────────────────────
# Path to the OAuth2 client credentials JSON downloaded from Google Cloud Console
# (APIs & Services → Credentials → OAuth 2.0 Client IDs → Download JSON)
GMAIL_CREDENTIALS_FILE=credentials.json

# Token file auto-generated after first OAuth consent (do NOT commit to git)
GMAIL_TOKEN_FILE=token.json

# ── Sync behaviour ─────────────────────────────────────────────────────────
# How often to check for new emails (seconds). Default: 60
POLL_INTERVAL_SECONDS=60

# Create a HubSpot Email activity on the contact timeline for each synced email
# Set to "false" to disable. Default: true
CREATE_TIMELINE=true

# Mark new contacts with hs_lead_status=NEW and store "Inbound Gmail" note
# Set to "false" to disable. Default: true
ADD_INBOUND_TAG=true
