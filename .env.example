# ── Gmail OAuth2 ──────────────────────────────────────────────────────────────
# Scarica da Google Cloud Console → API & Services → Credentials → OAuth 2.0 Client
GMAIL_CREDENTIALS_FILE=credentials.json
# Token generato automaticamente al primo avvio
GMAIL_TOKEN_FILE=token.json

# ── HubSpot ───────────────────────────────────────────────────────────────────
# Settings → Integrations → Private Apps → crea app con scope crm.objects.contacts
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Comportamento ─────────────────────────────────────────────────────────────
# Intervallo di polling in secondi (default: 60)
POLL_INTERVAL_SECONDS=60
# File di stato per riprendere da dove si era rimasti
STATE_FILE=sync_state.json
# Livello log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── Filtri mittenti ───────────────────────────────────────────────────────────
# Prefissi email da ignorare (bot, sistemi automatici)
SKIP_EMAIL_PREFIXES=noreply,no-reply,donotreply,mailer-daemon,postmaster,bounce,notifications
# Domini da ignorare completamente (es. domini interni aziendali)
SKIP_DOMAINS=
