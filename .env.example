# HubSpot Private App Access Token
# Crea un'app privata su: Settings → Integrations → Private Apps
# Scope necessari: crm.objects.contacts.read, crm.objects.contacts.write
HUBSPOT_ACCESS_TOKEN=your_hubspot_access_token_here

# Percorso al file credentials.json scaricato da Google Cloud Console
# (OAuth 2.0 Client ID per applicazione desktop)
GOOGLE_CREDENTIALS_FILE=credentials.json
