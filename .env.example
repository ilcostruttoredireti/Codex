# ─── HubSpot ──────────────────────────────────────────────────────────────────
# Create a Private App in HubSpot:
#   Settings → Integrations → Private Apps → Create private app
#   Required scopes: crm.objects.contacts.read  crm.objects.contacts.write
#                    crm.objects.notes.write
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxxxxxxxxxxxxxxxxxx

# ─── Gmail OAuth ──────────────────────────────────────────────────────────────
# Download credentials.json from Google Cloud Console:
#   APIs & Services → Credentials → Create OAuth 2.0 Client ID (Desktop app)
#   Save the file as  credentials.json  in the same folder as the script.
# The first run opens a browser to authorize access; token.json is saved automatically.

# ─── Optional tuning ──────────────────────────────────────────────────────────
# Polling interval in seconds (default: 300 = 5 minutes)
POLL_INTERVAL_SECONDS=300

# How many days back to scan on the very first run (no history ID yet)
SCAN_DAYS_ON_FIRST_RUN=1

# Comma-separated list of your own addresses — these are never synced as contacts
OWN_ADDRESSES=pubblica.latestata@gmail.com,cristian.mameli.editore@gmail.com,redazione@latestata.it
