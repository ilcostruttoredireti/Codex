# ── HubSpot ────────────────────────────────────────────────────────────────────
# Token del tuo Private App (HubSpot Settings → Integrations → Private Apps)
HUBSPOT_PRIVATE_APP_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Gmail ──────────────────────────────────────────────────────────────────────
# Percorso al file credentials.json scaricato da Google Cloud Console
GMAIL_CREDENTIALS_FILE=credentials.json

# Il tuo indirizzo Gmail (serve per non creare un contatto per se stessi)
MY_EMAIL=tuo@gmail.com

# ── Sync ───────────────────────────────────────────────────────────────────────
# Intervallo di polling in secondi (default: 60)
POLL_INTERVAL_SECONDS=60
