# HubSpot Private App token
# Crea un'app privata su: Settings → Integrations → Private Apps
# Scope necessari: crm.objects.contacts.read, crm.objects.contacts.write
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Secondi tra un ciclo di controllo e il successivo (default: 60)
POLL_INTERVAL_SECONDS=60
