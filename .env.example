# HubSpot private app access token
# Create at: https://app.hubspot.com/private-apps
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Path to Google OAuth2 credentials JSON downloaded from Google Cloud Console
GMAIL_CREDENTIALS_FILE=credentials.json

# Token cache (auto-generated on first run)
GMAIL_TOKEN_FILE=token.json

# Poll interval in seconds (default: 300 = 5 minutes)
SYNC_INTERVAL_SECONDS=300

# Path to state file that tracks the last processed message
STATE_FILE=sync_state.json

# Comma-separated email domains to ignore
IGNORED_DOMAINS=facebookmail.com,noreply.com,mailer-daemon.com,notifications.google.com
