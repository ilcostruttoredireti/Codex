# ─────────────────────────────────────────────────────────────────────────────
# Gmail → HubSpot Sync  —  Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your real values.
# The .env file must NOT be committed to version control.

# ── Gmail OAuth ───────────────────────────────────────────────────────────────
# 1. Go to https://console.cloud.google.com/
# 2. Create a project → Enable the Gmail API
# 3. Create OAuth 2.0 credentials (Desktop application)
# 4. Download the JSON and save it as credentials.json
GMAIL_CREDENTIALS_FILE=credentials.json

# Auto-generated on first run after you complete the OAuth browser flow.
# Do not edit manually.
GMAIL_TOKEN_FILE=token.json

# ── HubSpot Private App ───────────────────────────────────────────────────────
# 1. Go to HubSpot → Settings → Integrations → Private Apps
# 2. Create a Private App with scopes:
#      crm.objects.contacts.read
#      crm.objects.contacts.write
#      crm.objects.notes.write
# 3. Copy the generated access token below.
HUBSPOT_ACCESS_TOKEN=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Sync settings ─────────────────────────────────────────────────────────────
# How often (in seconds) to poll Gmail for new messages (default: 60)
POLL_INTERVAL_SECONDS=60

# Path to the local sync-state file (stores last Gmail historyId + processed IDs)
SYNC_STATE_FILE=sync_state.json
