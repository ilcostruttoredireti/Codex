# HubSpot Private App Token
# Crea un Private App su: HubSpot → Impostazioni → Integrazioni → App private
# Scopes richiesti: crm.objects.contacts.read, crm.objects.contacts.write, crm.objects.notes.write
HUBSPOT_API_TOKEN=your_hubspot_private_app_token_here

# Gmail OAuth2 credentials (scarica da Google Cloud Console)
# Abilita: Gmail API  |  Tipo credenziale: "App desktop"
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=gmail_token.json

# Intervallo di polling in secondi (default: 60)
POLL_INTERVAL_SECONDS=60

# File di stato locale per tracciare le email già processate
STATE_FILE=processed_emails.json

# Quanti giorni indietro cercare email al primo avvio (default: 7)
INITIAL_LOOKBACK_DAYS=7
