# ── HubSpot ────────────────────────────────────────────────────────────────────
# Private App access token (HubSpot → Settings → Integrations → Private Apps)
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Gmail ──────────────────────────────────────────────────────────────────────
# OAuth2 credentials JSON downloaded from Google Cloud Console
# (APIs & Services → Credentials → OAuth 2.0 Client IDs → Download JSON)
GMAIL_CREDENTIALS_FILE=credentials.json

# Token file written automatically on first run (after browser OAuth flow)
GMAIL_TOKEN_FILE=token.json

# ── Behaviour ──────────────────────────────────────────────────────────────────
# How often to poll Gmail for new messages (seconds)
POLL_INTERVAL_SECONDS=60
