# ─── HubSpot ──────────────────────────────────────────────────────────────────
# Private App access token (HubSpot > Settings > Integrations > Private Apps)
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token_here

# ─── Gmail OAuth2 ─────────────────────────────────────────────────────────────
# Path to the credentials.json downloaded from Google Cloud Console
GMAIL_CREDENTIALS_FILE=credentials.json

# Path where the OAuth2 token will be saved after first authentication
GMAIL_TOKEN_FILE=token.json

# ─── Sync behaviour ───────────────────────────────────────────────────────────
# Polling interval in seconds (default: 60)
POLL_INTERVAL=60

# Maximum emails to process per cycle (default: 50)
MAX_EMAILS_PER_CYCLE=50

# File used to persist the sync state across restarts
STATE_FILE=sync_state.json

# Create a HubSpot timeline note for every processed email (true/false)
ENABLE_TIMELINE_NOTES=true

# ─── Logging ──────────────────────────────────────────────────────────────────
# One of: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
