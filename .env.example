# Gmail OAuth2 credentials (download from Google Cloud Console)
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# HubSpot Private App token
# Create at: Settings → Integrations → Private Apps
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxxxxxx

# File to track processed messages and last check time
STATE_FILE=sync_state.json

# Polling interval in seconds (0 = run once and exit)
POLL_INTERVAL_SECONDS=300
