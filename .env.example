# HubSpot private app token
# Create at: Settings → Integrations → Private Apps
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Gmail OAuth credentials JSON file path (from Google Cloud Console)
GMAIL_CREDENTIALS_FILE=credentials.json

# Gmail OAuth token cache file (auto-generated on first run)
GMAIL_TOKEN_FILE=token.json

# Polling interval in seconds (default: 60)
POLL_INTERVAL_SECONDS=60

# How far back to fetch emails on first run (in days, default: 1)
INITIAL_LOOKBACK_DAYS=1
