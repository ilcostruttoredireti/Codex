# HubSpot Private App Token
# Create one at: Settings → Integrations → Private Apps
HUBSPOT_API_TOKEN=your_hubspot_private_app_token_here

# Path to the Gmail OAuth2 credentials JSON file
# Download from: Google Cloud Console → APIs & Services → Credentials
GMAIL_CREDENTIALS_FILE=credentials.json

# How often to check for new emails (seconds)
POLL_INTERVAL_SECONDS=60

# Maximum emails to process per poll cycle
MAX_MESSAGES_PER_POLL=50

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
