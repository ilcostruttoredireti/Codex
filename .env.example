# ── HubSpot ───────────────────────────────────────────────────────────────────
# Create a Private App in HubSpot (Settings → Integrations → Private Apps).
# Required scopes: crm.objects.contacts.read  crm.objects.contacts.write
#                  crm.objects.notes.write
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token_here

# ── Gmail OAuth ───────────────────────────────────────────────────────────────
# Download from Google Cloud Console → APIs & Services → Credentials
# (OAuth 2.0 Client ID → Desktop App → Download JSON)
GMAIL_CREDENTIALS_FILE=credentials.json

# Persisted OAuth token (created automatically on first run)
GMAIL_TOKEN_FILE=token.json

# ── Polling ───────────────────────────────────────────────────────────────────
# How often (seconds) to check Gmail for new messages
POLL_INTERVAL_SECONDS=60
