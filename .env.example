# ── Gmail ─────────────────────────────────────────────────────────────────────
# Path to the OAuth 2.0 client secrets JSON downloaded from Google Cloud Console.
# Enable the Gmail API and create credentials of type "Desktop app".
GMAIL_CREDENTIALS_FILE=credentials.json

# Path where the OAuth token is cached after the first login (auto-generated).
GMAIL_TOKEN_FILE=token.json

# ── HubSpot ───────────────────────────────────────────────────────────────────
# Private App access token from HubSpot Settings → Integrations → Private Apps.
# Required scopes: crm.objects.contacts.read  crm.objects.contacts.write
#                  crm.objects.notes.write
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Sync settings ─────────────────────────────────────────────────────────────
# How often to poll Gmail for new messages (seconds). Default: 60
POLL_INTERVAL_SECONDS=60

# File used to persist the Gmail history cursor and processed message IDs.
STATE_FILE=.sync_state.json
