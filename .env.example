# Gmail OAuth2 credentials (from Google Cloud Console)
GMAIL_CLIENT_ID=your_client_id_here
GMAIL_CLIENT_SECRET=your_client_secret_here
GMAIL_REFRESH_TOKEN=your_refresh_token_here

# HubSpot private app token (from HubSpot Developer settings)
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token_here

# Sync interval in minutes (default: 15)
SYNC_INTERVAL_MINUTES=15

# How many days back to look for emails on first run (default: 7)
INITIAL_LOOKBACK_DAYS=7

# State file path for tracking processed emails
STATE_FILE_PATH=./data/sync-state.json

# Skip patterns: comma-separated substrings that mark an address as automated
SKIP_PATTERNS=noreply,no-reply,notification,notify-,pinbot,ads-,bounce,donotreply,daemon,mailer-daemon,postmaster
