# ── Gmail ──────────────────────────────────────────────────────────────────
# Scarica il file OAuth 2.0 dalla Google Cloud Console
# https://console.cloud.google.com/apis/credentials
# Seleziona "Desktop app" e rinomina il file in credentials.json
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# ── HubSpot ─────────────────────────────────────────────────────────────────
# Private App token da HubSpot → Settings → Integrations → Private Apps
# Scope minimi richiesti: crm.objects.contacts.read, crm.objects.contacts.write,
#                          crm.objects.notes.write
HUBSPOT_API_KEY=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Sync ────────────────────────────────────────────────────────────────────
# Intervallo di polling in secondi (default: 60)
POLL_INTERVAL_SECONDS=60

# File di stato per tracciare i messaggi già processati
STATE_FILE=sync_state.json
