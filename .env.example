# Gmail OAuth credentials (download from Google Cloud Console)
GMAIL_CREDENTIALS_FILE=gmail_credentials.json
# Saved token (auto-generated after first OAuth login)
GMAIL_TOKEN_FILE=gmail_token.json
# Gmail search query for monitored emails
GMAIL_QUERY=in:inbox
# Comma-separated list of your own email addresses to skip as senders
OWN_EMAILS=you@gmail.com

# HubSpot Private App access token
HUBSPOT_ACCESS_TOKEN=pat-xx-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Polling interval in seconds
POLL_INTERVAL_SECONDS=60
# File to track already-processed Gmail message IDs
STATE_FILE=sync_state.json
