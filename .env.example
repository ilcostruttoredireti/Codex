# Gmail OAuth (download from Google Cloud Console → OAuth 2.0 credentials)
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# HubSpot Private App token (Settings → Integrations → Private Apps)
HUBSPOT_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# The Gmail address being monitored (used to skip self-sent emails)
OWN_EMAIL=you@gmail.com

# Polling interval in seconds (default 60)
POLL_INTERVAL=60

# State persistence file
STATE_FILE=.sync_state.json
