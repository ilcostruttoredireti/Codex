# HubSpot Private App token (Settings → Integrations → Private Apps)
HUBSPOT_API_KEY=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Path to Gmail OAuth2 client credentials JSON downloaded from Google Cloud Console
GMAIL_CREDENTIALS_FILE=credentials/gmail_credentials.json

# Path where the OAuth2 token will be stored after first login
GMAIL_TOKEN_FILE=credentials/gmail_token.json

# Polling interval in seconds (default: 60)
POLL_INTERVAL_SECONDS=60

# File used to persist sync state between restarts
STATE_FILE=state.json

# Optional: HubSpot static list ID for "Inbound Gmail" tagging
# Create a static list in HubSpot and paste its numeric ID here
# Leave empty to skip list assignment
HUBSPOT_INBOUND_LIST_ID=

# Optional: log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
