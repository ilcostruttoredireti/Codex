# HubSpot private-app access token
# Create one at: Settings → Integrations → Private Apps
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Path to the OAuth2 credentials JSON downloaded from Google Cloud Console
# Required scopes: https://www.googleapis.com/auth/gmail.readonly
GMAIL_CREDENTIALS_FILE=credentials.json

# Path where the OAuth2 token will be stored after first login
GMAIL_TOKEN_FILE=token.json

# How often (seconds) to check for new emails
POLL_INTERVAL_SECONDS=60

# File used to persist the Gmail historyId across restarts
STATE_FILE=state.json
