# Gmail OAuth2 credentials (from Google Cloud Console)
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# HubSpot Private App token
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token_here

# Sync settings
POLL_INTERVAL_SECONDS=60
# Comma-separated list of label IDs/names to filter (leave empty for all INBOX)
GMAIL_LABEL_FILTER=INBOX
# Skip emails from these domains (comma-separated)
SKIP_DOMAINS=noreply.com,no-reply.com,mailer-daemon.google.com
