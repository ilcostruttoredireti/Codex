# HubSpot Private App access token
# Crea un Private App in HubSpot > Settings > Integrations > Private Apps
# Scope richiesti: crm.objects.contacts.read, crm.objects.contacts.write, crm.objects.notes.write
HUBSPOT_ACCESS_TOKEN=pat-eu1-xxxxxxxxxxxxxxxxxxxx

# Percorsi file credenziali Gmail OAuth2
# Scarica credentials.json da Google Cloud Console > APIs > Credentials > OAuth 2.0 Client IDs
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# Intervallo di polling in secondi (default: 60)
POLL_INTERVAL=60
