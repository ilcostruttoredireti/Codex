# HubSpot Private App Token (Settings → Integrations → Private Apps)
HUBSPOT_API_KEY=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Path to Google OAuth2 credentials JSON (download from Google Cloud Console)
GMAIL_CREDENTIALS_FILE=credentials.json

# Path to the saved OAuth2 token (auto-created on first run)
GMAIL_TOKEN_FILE=token.json

# Polling interval in seconds (default: 300 = 5 minutes)
POLL_INTERVAL_SECONDS=300

# SQLite database to track processed email threads
DB_FILE=processed_emails.db
