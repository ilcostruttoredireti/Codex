# ── HubSpot ───────────────────────────────────────────────────────────────────
# Crea un'app privata in HubSpot → Impostazioni → Integrazioni → App private
# Concedi almeno: CRM contacts (read + write), CRM notes (write)
HUBSPOT_TOKEN=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Gmail OAuth ────────────────────────────────────────────────────────────────
# Scarica le credenziali OAuth2 dalla Google Cloud Console (tipo "Desktop app")
# e salvale come credentials.json nella stessa cartella dello script.
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# ── Comportamento ─────────────────────────────────────────────────────────────
# Il tuo indirizzo Gmail: i messaggi inviati da questo indirizzo vengono ignorati
GMAIL_OWN_EMAIL=tuo.indirizzo@gmail.com

# Query Gmail (stessa sintassi della barra di ricerca di Gmail)
GMAIL_QUERY=in:inbox

# Numero massimo di messaggi da controllare per ogni ciclo
GMAIL_MAX_RESULTS=50

# File JSON che traccia i messaggi già elaborati (evita duplicati tra cicli)
STATE_FILE=processed_messages.json

# Secondi tra un ciclo e l'altro nella modalità loop continuo
POLL_INTERVAL_SECONDS=300
