# HubSpot Private App Access Token
# Crea un'app privata in HubSpot Settings > Integrations > Private Apps
# Permessi richiesti: crm.objects.contacts.read, crm.objects.contacts.write
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Intervallo di polling Gmail (secondi)
POLL_INTERVAL_SECONDS=60

# File per tenere traccia dei messaggi già processati
PROCESSED_IDS_FILE=.processed_message_ids.json

# File OAuth Gmail (scarica da Google Cloud Console)
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
