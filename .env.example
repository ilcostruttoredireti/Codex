# ──────────────────────────────────────────────
# Gmail → HubSpot Sync — Configurazione
# ──────────────────────────────────────────────

# HubSpot Private App Token
# Crea su: https://app.hubspot.com/private-apps
# Scopes necessari: crm.objects.contacts.read, crm.objects.contacts.write,
#                   crm.objects.notes.read, crm.objects.notes.write
HUBSPOT_API_KEY=your_hubspot_private_app_token_here

# Percorso del file credentials.json scaricato da Google Cloud Console
# Default: credentials.json nella stessa directory
GMAIL_CREDENTIALS_FILE=credentials.json
