# HubSpot Private App token
# Crea un'app privata su: https://app.hubspot.com/private-apps
# Scopes richiesti: crm.objects.contacts.read, crm.objects.contacts.write, crm.objects.notes.write
HUBSPOT_ACCESS_TOKEN=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Email dell'account Gmail monitorato (viene saltata se appare come mittente)
MY_EMAIL=tua@email.it

# Secondi tra un ciclo di polling e l'altro (default: 60)
POLL_INTERVAL=60

# Query Gmail personalizzata (default: in:inbox -from:me newer_than:1d)
# GMAIL_QUERY=in:inbox -from:me newer_than:7d
