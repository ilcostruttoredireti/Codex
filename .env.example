# ── Gmail OAuth2 ──────────────────────────────────────────────────────────────
# Download credentials.json from Google Cloud Console:
# APIs & Services → Credentials → OAuth 2.0 Client IDs → Desktop app
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# ── HubSpot ───────────────────────────────────────────────────────────────────
# Create a Private App in HubSpot → Settings → Integrations → Private Apps
# Required scopes: crm.objects.contacts.read, crm.objects.contacts.write,
#                  crm.objects.notes.write
HUBSPOT_TOKEN=your_hubspot_private_app_token_here

# ── Sync behaviour ────────────────────────────────────────────────────────────
# Poll interval in seconds (default: 60)
GMAIL_POLL_INTERVAL=60

# Comma-separated list of forwarder addresses whose body contains the real sender
FORWARDER_ADDRESSES=redazione@latestata.it

# Path to the JSON file that tracks processed message IDs
STATE_FILE=state.json
