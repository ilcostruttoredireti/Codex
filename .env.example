# HubSpot Private App token (Settings → Integrations → Private Apps)
HUBSPOT_API_KEY=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Path to Google OAuth2 client credentials JSON downloaded from Google Cloud Console
GMAIL_CREDENTIALS_FILE=credentials.json

# Path where the OAuth token will be cached after first login
GMAIL_TOKEN_FILE=token.json

# How often to poll Gmail for new threads (seconds)
POLL_INTERVAL_SECONDS=300

# Comma-separated emails to skip (e.g. your own addresses)
SKIP_EMAILS=cristian.mameli.editore@gmail.com,pubblica.latestata@gmail.com

# Comma-separated relay/forwarding addresses whose body will be parsed
# for the original sender instead of using the envelope From
RELAY_SENDERS=redazione@latestata.it

# Path for the JSON file that tracks already-processed thread IDs
STATE_FILE=state.json
