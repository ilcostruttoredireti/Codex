# ─── HubSpot ────────────────────────────────────────────────────────────────
# Private App token from HubSpot → Settings → Integrations → Private Apps
HUBSPOT_API_KEY=your-hubspot-private-app-token

# ─── Gmail ──────────────────────────────────────────────────────────────────
# Path to the OAuth2 credentials JSON downloaded from Google Cloud Console
# (APIs & Services → Credentials → OAuth 2.0 Client IDs → Download JSON)
GMAIL_CREDENTIALS_FILE=credentials.json

# Path where the OAuth2 token is cached after first login
GMAIL_TOKEN_FILE=token.json

# ─── Polling ────────────────────────────────────────────────────────────────
# How often (in seconds) to check for new emails
POLL_INTERVAL_SECONDS=60

# ─── Filters ────────────────────────────────────────────────────────────────
# Comma-separated list of sender domains to ignore entirely
# (e.g. internal company addresses, mailing-list domains)
IGNORED_DOMAINS=noreply.github.com,notifications.google.com
