# HubSpot Private App token
# Settings → Integrations → Private Apps → Create private app
# Required scopes: crm.objects.contacts.read, crm.objects.contacts.write
HUBSPOT_TOKEN=your_hubspot_private_app_token_here

# Path to credentials.json downloaded from Google Cloud Console
# APIs & Services → Credentials → OAuth 2.0 Client ID → Download JSON
GMAIL_CREDENTIALS_FILE=credentials.json

# Paths for persisted state (created automatically)
GMAIL_TOKEN_FILE=token.json
GMAIL_STATE_FILE=gmail_state.json
