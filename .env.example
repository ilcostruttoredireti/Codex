# ── HubSpot ───────────────────────────────────────────────────────────────────
# Crea un Private App su HubSpot → Settings → Integrations → Private Apps
# Scopes richiesti: crm.objects.contacts.read, crm.objects.contacts.write,
#                   crm.objects.notes.write
HUBSPOT_API_KEY=your-hubspot-private-app-token

# ── Gmail OAuth ───────────────────────────────────────────────────────────────
# Percorso del file credentials.json scaricato da Google Cloud Console
GMAIL_CREDENTIALS_FILE=credentials.json
# Il token OAuth viene generato automaticamente da setup_gmail.py
GMAIL_TOKEN_FILE=token.json

# ── Sync settings ─────────────────────────────────────────────────────────────
# Intervallo di polling in secondi (default: 60)
POLL_INTERVAL_SECONDS=60
# File di stato per riprendere dal punto in cui ci si è fermati
STATE_FILE=sync_state.json
