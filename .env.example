# HubSpot Private App token
# Crea un'app privata su: HubSpot → Impostazioni → Integrazioni → App private
# Scope necessari: crm.objects.contacts.read, crm.objects.contacts.write, crm.objects.notes.write
HUBSPOT_API_KEY=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Percorso al file credentials.json scaricato da Google Cloud Console
# Abilita Gmail API su: console.cloud.google.com → API & Services → Library
GMAIL_CREDENTIALS_FILE=credentials.json

# Intervallo di polling in secondi (default: 60)
POLL_INTERVAL_SECONDS=60
