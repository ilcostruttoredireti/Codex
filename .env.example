# ── HubSpot ──────────────────────────────────────────────────────────────────
# Private App token: HubSpot > Settings > Integrations > Private Apps
HUBSPOT_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Gmail ────────────────────────────────────────────────────────────────────
# Percorso del file credentials.json scaricato da Google Cloud Console
# (OAuth 2.0 → Desktop app)
GMAIL_CREDENTIALS_FILE=credentials.json

# File token generato automaticamente al primo avvio (non serve cambiarlo)
GMAIL_TOKEN_FILE=token.json

# ── Sync ─────────────────────────────────────────────────────────────────────
# Intervallo di polling in secondi (default: 60)
POLL_INTERVAL_SECONDS=60
