# HubSpot Private App Token (required)
# Create one at: Settings > Integrations > Private Apps
HUBSPOT_API_TOKEN=your_hubspot_private_app_token_here

# Gmail OAuth credentials file (required for first run)
# Download from: Google Cloud Console > APIs & Credentials > OAuth 2.0
GMAIL_CREDENTIALS_FILE=credentials.json

# Gmail token file (auto-generated after first OAuth login)
GMAIL_TOKEN_FILE=token.json

# How often to poll Gmail for new emails (seconds)
POLL_INTERVAL_SECONDS=60

# File to persist sync state between restarts
STATE_FILE=sync_state.json

# Whether to skip contacts with personal email domains (gmail, yahoo, etc.)
# Set to "false" to sync all contacts regardless of domain
SKIP_PERSONAL_DOMAINS=false
