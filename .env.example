# ─── HubSpot ──────────────────────────────────────────────────────────────────
# Private App token: HubSpot → Settings → Integrations → Private Apps
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ─── Gmail ────────────────────────────────────────────────────────────────────
# Path to the OAuth 2.0 credentials JSON downloaded from Google Cloud Console.
# Default: credentials.json  (in the same directory as the script)
GMAIL_CREDENTIALS_FILE=credentials.json

# ─── Tuning ───────────────────────────────────────────────────────────────────
# How often (seconds) to poll Gmail for new messages. Default: 60
POLL_INTERVAL=60

# How many days back to scan for messages. Default: 7
LOOKBACK_DAYS=7

# Maximum messages processed per cycle. Default: 50
MAX_PER_CYCLE=50
