# ── Gmail ──────────────────────────────────────────────────────────────────────────
# Path to the OAuth 2.0 credentials JSON downloaded from Google Cloud Console
GMAIL_CREDENTIALS_FILE=credentials.json

# Path where the OAuth token will be cached after first login
GMAIL_TOKEN_FILE=token.json

# ── HubSpot ─────────────────────────────────────────────────────────────────────────
# Private App access token from HubSpot Settings → Integrations → Private Apps
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Sync behaviour ─────────────────────────────────────────────────────────────
# How often to poll Gmail for new messages (seconds)
POLL_INTERVAL_SECONDS=60

# File used to persist the last processed Gmail history ID
STATE_FILE=.sync_state.json
