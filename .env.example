# Gmail OAuth2 credentials (from Google Cloud Console)
GMAIL_CLIENT_ID=your_client_id_here
GMAIL_CLIENT_SECRET=your_client_secret_here
GMAIL_REFRESH_TOKEN=your_refresh_token_here

# HubSpot Private App token (Settings > Integrations > Private Apps)
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token_here

# Sync configuration
SYNC_INTERVAL_MINUTES=15
LOOKBACK_DAYS=1
DRY_RUN=false

# Gmail label to apply after processing (optional)
PROCESSED_LABEL=HubSpot-Synced
