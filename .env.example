# ── HubSpot ──────────────────────────────────────────────────────────────────
# Generate a Private App token in HubSpot → Settings → Integrations → Private Apps
# Required scopes: crm.objects.contacts.read, crm.objects.contacts.write,
#                  crm.objects.notes.write
HUBSPOT_ACCESS_TOKEN=your-hubspot-private-app-token

# ── Gmail ─────────────────────────────────────────────────────────────────────
# Path to the OAuth2 credentials JSON downloaded from Google Cloud Console
# (APIs & Services → Credentials → OAuth 2.0 Client IDs → Download JSON)
GMAIL_CREDENTIALS_PATH=credentials.json

# ── Sync behaviour ────────────────────────────────────────────────────────────
# How often to poll Gmail for new emails (seconds, default: 60)
POLL_INTERVAL_SECONDS=60
