# Gmail OAuth2 credentials (download from Google Cloud Console)
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# HubSpot Private App token (Settings → Integrations → Private Apps)
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Sync settings
POLL_INTERVAL_SECONDS=300   # seconds between Gmail polls (default: 5 min)
LOOKBACK_DAYS=1             # how far back to look on the very first run
STATE_FILE=.sync_state.json # file that persists last-processed timestamp
