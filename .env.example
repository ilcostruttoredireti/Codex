# ── HubSpot ──────────────────────────────────────────────────────────────────
# Private-app token from HubSpot → Settings → Integrations → Private Apps
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Gmail OAuth ───────────────────────────────────────────────────────────────
# Path to the credentials JSON downloaded from Google Cloud Console
# (OAuth 2.0 Client ID, Desktop-app type)
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# ── Sync behaviour ────────────────────────────────────────────────────────────
# Seconds between Gmail polls when running in daemon mode (default 60)
POLL_INTERVAL_SECONDS=60

# Where to persist processed message IDs and last-run timestamp
STATE_FILE=.sync_state.json

# Comma-separated free-mail domains to skip contact creation for
SKIP_FREE_DOMAINS=gmail.com,yahoo.com,hotmail.com,outlook.com,live.com,icloud.com

# Skip noreply / automated senders (true/false)
SKIP_NOREPLY=true

# Gmail label applied to every processed thread (created automatically)
GMAIL_SYNCED_LABEL=HubSpot-Synced

# HubSpot lifecycle stage assigned to newly created contacts
# Values: subscriber | lead | marketingqualifiedlead | salesqualifiedlead |
#         opportunity | customer | evangelist | other
NEW_CONTACT_LIFECYCLE=lead
