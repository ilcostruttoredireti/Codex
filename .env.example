# ─── Gmail OAuth2 ────────────────────────────────────────────────────────────
# Scarica credentials.json da Google Cloud Console
# APIs & Services > Credentials > OAuth 2.0 Client IDs > Download JSON
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# ─── HubSpot Private App ──────────────────────────────────────────────────────
# Crea un Private App su HubSpot: Settings > Integrations > Private Apps
# Permessi richiesti: crm.objects.contacts.read, crm.objects.contacts.write,
#                     crm.objects.notes.write
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ─── Sync Settings ────────────────────────────────────────────────────────────
POLLING_INTERVAL=60         # secondi tra un poll e l'altro
STATE_FILE=.sync_state.json # file di stato per la sincronizzazione incrementale
LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR
INITIAL_MESSAGES=50         # quante email processare al primo avvio
