# ── Gmail OAuth2 ──────────────────────────────────────────────────────────────
# Download credentials.json from Google Cloud Console → APIs & Services → Credentials
GMAIL_CREDENTIALS_FILE=credentials.json
# Auto-generated on first run after OAuth consent
GMAIL_TOKEN_FILE=token.json

# ── HubSpot ───────────────────────────────────────────────────────────────────
# Create a Private App in HubSpot Settings → Integrations → Private Apps
# Required scopes: crm.objects.contacts.read, crm.objects.contacts.write,
#                  crm.objects.notes.write, crm.associations.write
HUBSPOT_ACCESS_TOKEN=pat-xx-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Sync behaviour ────────────────────────────────────────────────────────────
# Gmail label applied to processed emails (prevents reprocessing)
GMAIL_PROCESSED_LABEL=HubSpot Synced

# Polling interval for continuous mode (seconds)
POLL_INTERVAL_SECONDS=60

# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
