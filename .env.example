# HubSpot private-app access token (required)
# Create one at: Settings → Integrations → Private Apps
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# How often to poll Gmail for new messages (seconds, default: 60)
POLL_INTERVAL=60

# Gmail label applied to processed threads (created automatically if missing)
GMAIL_LABEL=Inbound Gmail

# Log verbosity: DEBUG | INFO | WARNING (default: INFO)
LOG_LEVEL=INFO
