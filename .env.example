# Gmail OAuth2 credentials (scarica da Google Cloud Console)
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# HubSpot Private App token (Impostazioni → Integrazioni → App private)
HUBSPOT_API_KEY=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Sincronizzazione
POLL_INTERVAL_SECONDS=300      # Intervallo polling in secondi (default: 5 minuti)
STATE_FILE=sync_state.json     # File di stato per tracciare l'ultima sincronizzazione
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
