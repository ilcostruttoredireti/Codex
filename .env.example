# Gmail OAuth2 credentials (from Google Cloud Console)
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# HubSpot Private App Token
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token_here

# Sync settings
POLL_INTERVAL_SECONDS=60
MAX_EMAILS_PER_POLL=50
CONTACT_SOURCE_LABEL=Gmail

# Optional: Gmail label to apply after processing
GMAIL_PROCESSED_LABEL=hubspot-synced

# Logging
LOG_LEVEL=INFO
