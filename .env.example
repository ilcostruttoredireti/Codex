# ── Gmail ─────────────────────────────────────────────────────
# Percorso al file JSON delle credenziali OAuth2 scaricato da Google Cloud Console.
# (API & Services → Credentials → Create Credentials → OAuth client ID → Desktop app)
GMAIL_CREDENTIALS_PATH=gmail_credentials.json

# Il token OAuth viene generato automaticamente al primo avvio.
GMAIL_TOKEN_PATH=gmail_token.json

# ── HubSpot ───────────────────────────────────────────────────
# Token di accesso di una Private App HubSpot.
# (HubSpot → Settings → Integrations → Private Apps → Create)
# Scopes richiesti: crm.objects.contacts.read, crm.objects.contacts.write,
#                   crm.objects.notes.write
HUBSPOT_ACCESS_TOKEN=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Sync settings ─────────────────────────────────────────────
# Secondi tra una sync e l'altra in modalità --continuous (default: 300 = 5 min)
SYNC_INTERVAL_SECONDS=300

# Giorni di lookback alla prima esecuzione (default: 7)
FIRST_RUN_LOOKBACK_DAYS=7

# Max messaggi processati per ciclo (default: 100)
MAX_MESSAGES_PER_CYCLE=100
