# HubSpot Private App access token
# Create one at: Settings → Integrations → Private Apps
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token_here

# Path to the Gmail OAuth2 credentials JSON downloaded from Google Cloud Console
GMAIL_CREDENTIALS_FILE=credentials.json

# Path where the OAuth2 token will be stored after first auth
GMAIL_TOKEN_FILE=token.json

# Poll interval in seconds (only used in continuous mode)
POLL_INTERVAL=60

# File used to track already-processed Gmail message IDs across restarts
PROCESSED_IDS_FILE=.processed_message_ids.json
