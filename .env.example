# HubSpot Private App Access Token (required)
# Create one at: HubSpot Settings > Integrations > Private Apps
HUBSPOT_ACCESS_TOKEN=pat-eu1-xxxxxxxxxxxx

# Gmail OAuth credentials file (from Google Cloud Console)
GMAIL_CREDENTIALS_FILE=credentials.json

# Path where the OAuth token is stored after first login
GMAIL_TOKEN_FILE=token.json

# How often to poll Gmail inbox (seconds)
POLL_INTERVAL_SECONDS=60

# How far back to look for emails on each cycle (minutes)
LOOKBACK_MINUTES=60
