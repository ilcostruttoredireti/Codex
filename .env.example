# HubSpot Private App Access Token
# Crea un'app privata su: app.hubspot.com → Impostazioni → Integrazioni → App private
# Scope richiesti: crm.objects.contacts.read, crm.objects.contacts.write,
#                  crm.objects.notes.read, crm.objects.notes.write
HUBSPOT_ACCESS_TOKEN=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# (Opzionale) Percorso al file credentials.json di Google OAuth
# Default: credentials.json nella directory corrente
GOOGLE_CREDENTIALS_FILE=credentials.json

# Intervallo di polling in secondi (default: 60)
POLL_INTERVAL_SECONDS=60

# Numero massimo di email per ciclo (default: 50)
MAX_EMAILS_PER_CYCLE=50
