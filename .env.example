# HubSpot Private App access token
# Generate it from: HubSpot > Settings > Integrations > Private Apps
HUBSPOT_ACCESS_TOKEN=your_private_app_token_here

# Seconds between each Gmail polling cycle (default: 60)
POLL_INTERVAL=60

# Number of recent emails to process on first run (0 = only future emails)
INITIAL_MESSAGES=10

# Add a note/timeline activity for each synced email (true/false)
ADD_TIMELINE_NOTES=true

# File to persist sync state between restarts
STATE_FILE=gmail_sync_state.json
