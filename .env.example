# ── Gmail OAuth ───────────────────────────────────────────────────────────────
# Path to the OAuth 2.0 credentials JSON downloaded from Google Cloud Console
# (APIs & Services → Credentials → OAuth 2.0 Client IDs → Download JSON)
GMAIL_CREDENTIALS_FILE=credentials.json

# Your own Gmail address — emails sent from this address are skipped
OWN_EMAIL=you@gmail.com

# ── HubSpot ───────────────────────────────────────────────────────────────────
# Private App access token from HubSpot
# (Settings → Integrations → Private Apps → Create a private app)
# Required scopes: crm.objects.contacts.read  crm.objects.contacts.write
HUBSPOT_ACCESS_TOKEN=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Sync behaviour ────────────────────────────────────────────────────────────
# How often (seconds) to poll Gmail in continuous mode (default: 60)
POLL_INTERVAL_SECONDS=60
