# HubSpot Private App token (Settings → Integrations → Private Apps)
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Path to Google OAuth2 credentials JSON downloaded from Google Cloud Console
GMAIL_CREDENTIALS_FILE=credentials.json

# Token cache (created automatically after first OAuth2 login)
GMAIL_TOKEN_FILE=token.json

# How often to poll Gmail (seconds)
POLL_INTERVAL_SECONDS=60

# Where to store processed message IDs and historyId
SYNC_STATE_FILE=sync_state.json
