# ── HubSpot ───────────────────────────────────────────────────────────────────
# Create a Private App in HubSpot → Settings → Integrations → Private Apps
# Required scopes: crm.objects.contacts.read  crm.objects.contacts.write  crm.objects.notes.write
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Gmail OAuth ───────────────────────────────────────────────────────────────
# Download from Google Cloud Console → APIs & Services → Credentials
# (OAuth 2.0 Client ID, type "Desktop app")
GMAIL_CREDENTIALS_FILE=credentials.json

# Path where the OAuth token is cached after first login (auto-created)
GMAIL_TOKEN_FILE=token.json

# ── Behaviour ─────────────────────────────────────────────────────────────────
# Gmail search query applied to every poll cycle
GMAIL_QUERY=in:inbox -from:me

# Seconds between polls when running with --daemon
POLL_INTERVAL=60

# Path to JSON file that tracks already-processed message IDs
STATE_FILE=processed_threads.json

# Log file (leave blank to log to stdout only)
LOG_FILE=sync.log
