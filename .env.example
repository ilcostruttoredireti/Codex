# --- Gmail OAuth2 ---
# Scarica credentials.json da Google Cloud Console:
# https://console.cloud.google.com/ → APIs & Services → Credentials → OAuth 2.0 Client ID
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# --- HubSpot Private App ---
# Crea un Private App su HubSpot: Settings → Integrations → Private Apps
# Scopes richiesti: crm.objects.contacts.read, crm.objects.contacts.write, crm.objects.notes.write
HUBSPOT_ACCESS_TOKEN=your-hubspot-private-app-token

# --- Sync settings ---
# Intervallo di polling in secondi (default: 60)
POLL_INTERVAL_SECONDS=60

# Label Gmail usata per marcare le email già processate (creata automaticamente)
GMAIL_PROCESSED_LABEL=HubSpot-Processed

# Abilita creazione nota attività su HubSpot per ogni email processata (true/false)
ENABLE_ACTIVITY_NOTE=true

LOG_LEVEL=INFO
