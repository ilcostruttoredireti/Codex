# HubSpot Private App access token
# Crea un Private App su: https://app.hubspot.com/private-apps
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Percorso al file credentials.json scaricato da Google Cloud Console
# Abilita Gmail API su: https://console.cloud.google.com/apis/library/gmail.googleapis.com
GMAIL_CREDENTIALS_FILE=credentials.json

# Percorso dove salvare il token OAuth2 (generato automaticamente al primo run)
GMAIL_TOKEN_FILE=token.json

# Intervallo di polling in secondi (default: 60)
POLL_INTERVAL_SECONDS=60

# File di stato per tracciare la posizione nella history Gmail
STATE_FILE=.sync_state.json
