# HubSpot Private App access token
# Crea un Private App in HubSpot → Settings → Integrations → Private Apps
# Scope necessari: crm.objects.contacts.read, crm.objects.contacts.write
HUBSPOT_ACCESS_TOKEN=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# (opzionale) Livello di log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
