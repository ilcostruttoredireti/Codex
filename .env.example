# HubSpot private app token (Settings > Integrations > Private Apps)
HUBSPOT_API_KEY=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Gmail OAuth2 credentials (downloaded from Google Cloud Console)
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# Polling interval in seconds (default 300 = 5 min)
SYNC_INTERVAL_SECONDS=300

# On first run, look this many hours back in the inbox (default 24)
LOOKBACK_HOURS=24
