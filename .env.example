# ── HubSpot ──────────────────────────────────────────────────────────────────
# Create a Private App in HubSpot → Settings → Integrations → Private Apps
# Required scopes: crm.objects.contacts.read, crm.objects.contacts.write
HUBSPOT_ACCESS_TOKEN=your-private-app-token-here

# ── Gmail OAuth2 ──────────────────────────────────────────────────────────────
# Download credentials from Google Cloud Console → APIs & Services → Credentials
# Enable the Gmail API for your project first.
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# ── Own email addresses to skip (add yours here) ─────────────────────────────
OWN_EMAIL_1=cristian.mameli.editore@gmail.com
OWN_EMAIL_2=redazione@latestata.it
OWN_EMAIL_3=pubblica.latestata@gmail.com
OWN_EMAIL_4=

# ── Sync behaviour ───────────────────────────────────────────────────────────
# How often to poll Gmail for new threads (seconds)
POLL_INTERVAL_SECONDS=60
# How many days back to look for threads on each pass
LOOKBACK_DAYS=7
# File that tracks already-processed Gmail thread IDs
STATE_FILE=state.json
