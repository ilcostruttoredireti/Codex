# HubSpot private app token (Settings → Integrations → Private Apps)
HUBSPOT_ACCESS_TOKEN=your_hubspot_token_here

# Path to the OAuth2 credentials JSON downloaded from Google Cloud Console
# (APIs & Services → Credentials → OAuth 2.0 Client IDs → Download JSON)
GOOGLE_CREDENTIALS_FILE=credentials.json

# Auto-generated on first run after browser authentication
GOOGLE_TOKEN_FILE=token.json
