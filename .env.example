# Gmail → HubSpot Sync — variabili d'ambiente
# Copia in .env e compila con i tuoi valori

# HubSpot Private App Token (Impostazioni → Integrazioni → App private)
HUBSPOT_API_KEY=pat-xx-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Path al file credentials.json scaricato da Google Cloud Console
GMAIL_CREDENTIALS=credentials.json

# Path al file token.json (generato automaticamente al primo avvio OAuth)
GMAIL_TOKEN=token.json

# Nome della label Gmail per marcare le email già processate
GMAIL_LABEL_SYNCED=HubSpot-Synced

# Quanti giorni indietro cercare alla prima esecuzione (default 7)
DAYS_BACK=7
