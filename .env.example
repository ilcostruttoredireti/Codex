# ─────────────────────────────────────────────────────────────────────────────
# HubSpot — Private App token
# Crea un Private App su: HubSpot → Impostazioni → Integrazioni → App private
# Scopes necessari:
#   crm.objects.contacts.read
#   crm.objects.contacts.write
#   crm.objects.notes.write
# ─────────────────────────────────────────────────────────────────────────────
HUBSPOT_ACCESS_TOKEN=pat-xx-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────────────────────
# Gmail — OAuth2 credentials
# 1. Vai su https://console.cloud.google.com
# 2. Crea un progetto e abilita l'API Gmail
# 3. Crea credenziali OAuth2 → Applicazione desktop
# 4. Scarica il file JSON e salvalo come credentials.json
# ─────────────────────────────────────────────────────────────────────────────
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# ─────────────────────────────────────────────────────────────────────────────
# Sync settings
# ─────────────────────────────────────────────────────────────────────────────

# Intervallo di polling in secondi (default: 60)
POLL_INTERVAL_SECONDS=60

# File per salvare il checkpoint (historyId Gmail, contatore processati)
STATE_FILE=sync_state.json

# Livello di log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ─────────────────────────────────────────────────────────────────────────────
# Filtri — opzionali
# ─────────────────────────────────────────────────────────────────────────────

# Domini da ignorare completamente (separati da virgola)
# IGNORE_DOMAINS=spam-domain.com,another.com

# Indirizzi email specifici da ignorare (separati da virgola)
# IGNORE_EMAILS=alerts@service.com,bot@example.com
