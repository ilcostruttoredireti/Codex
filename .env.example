# HubSpot Private App access token
# Create one at: HubSpot > Settings > Integrations > Private Apps
HUBSPOT_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Path to the OAuth2 client credentials JSON downloaded from Google Cloud Console
# APIs & Services > Credentials > OAuth 2.0 Client IDs > Download JSON
GMAIL_CREDENTIALS=credentials.json

# Where the script stores the OAuth2 token after first login (auto-created)
GMAIL_TOKEN=token.json

# File that tracks already-processed Gmail message IDs (auto-created)
STATE_FILE=sync_state.json

# Seconds between inbox polls in daemon mode
POLL_INTERVAL=60

# Gmail label applied to every processed message
GMAIL_LABEL=Inbound Gmail

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
