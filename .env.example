# Gmail → HubSpot Sync Agent — Environment Variables

# Required: Anthropic API key
ANTHROPIC_API_KEY=sk-ant-...

# ── MCP Server Config ────────────────────────────────────────────────────────
# The agent auto-detects /tmp/mcp-config-cse_*.json when running inside a
# Claude Code session. For other environments, use one of these options:

# Option A: Point to the session config file directly
# MCP_CONFIG_PATH=/tmp/mcp-config-cse_<session-id>.json

# Option B: Set individual server values
# MCP_SESSION_UUID=cse_...
# GMAIL_MCP_URL=https://api.anthropic.com/v2/ccr-sessions/cse_.../mcp?mcp_url=...
# GMAIL_MCP_SERVER_ID=...
# HUBSPOT_MCP_URL=https://api.anthropic.com/v2/ccr-sessions/cse_.../mcp?mcp_url=...
# HUBSPOT_MCP_SERVER_ID=...

# ── Runtime Tuning ────────────────────────────────────────────────────────────
# Seconds between polls when running with --watch (default: 60)
POLL_INTERVAL_SECONDS=60

# Max emails processed per run (default: 20)
MAX_EMAILS_PER_RUN=20
