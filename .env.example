# ──────────────────────────────────────────────
# Gmail → HubSpot Sync — environment variables
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# HubSpot Private App access token (required)
# Create one at: Settings → Integrations → Private Apps
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token_here

# Gmail OAuth credentials file downloaded from Google Cloud Console
# (APIs & Services → Credentials → OAuth 2.0 Client ID → Desktop app)
GMAIL_CREDENTIALS_FILE=credentials.json

# OAuth token cache — created automatically on first login
GMAIL_TOKEN_FILE=token.json

# How often to poll Gmail for new messages (seconds)
POLL_INTERVAL_SECONDS=60

# File used to persist Gmail historyId and processed message IDs
STATE_FILE=sync_state.json

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
