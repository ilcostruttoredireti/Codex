# Gmail OAuth2 credentials (download from Google Cloud Console)
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# HubSpot private app token
# https://developers.hubspot.com/docs/api/private-apps
HUBSPOT_ACCESS_TOKEN=your-hubspot-private-app-token

# Polling interval in seconds (default: 60)
POLL_INTERVAL=60

# Gmail label/query to monitor (default: inbox unread)
GMAIL_QUERY=is:unread in:inbox

# Optional: skip emails from these domains (comma-separated)
IGNORED_DOMAINS=noreply.com,no-reply.com,mailer.example.com
