# ── HubSpot ────────────────────────────────────────────────────────────────────
# Create a Private App in HubSpot (Settings → Integrations → Private Apps)
# and grant scopes: crm.objects.contacts.read, crm.objects.contacts.write,
# crm.objects.notes.write, crm.associations.write
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token_here

# ── Gmail OAuth ────────────────────────────────────────────────────────────────
# Download credentials.json from Google Cloud Console
# (APIs & Services → Credentials → OAuth 2.0 Client ID → Desktop app)
GMAIL_CREDENTIALS_FILE=credentials.json

# Path where the OAuth token is cached after the first browser authorisation
GMAIL_TOKEN_FILE=token.json

# ── Sync behaviour ─────────────────────────────────────────────────────────────
# How often (in seconds) to poll Gmail for new messages
POLL_INTERVAL_SECONDS=60

# File used to persist the Gmail history cursor between restarts
STATE_FILE=sync_state.json
