# HubSpot Private App Token
# Generate at: HubSpot → Settings → Integrations → Private Apps
HUBSPOT_TOKEN=your_hubspot_private_app_token_here

# Gmail OAuth credentials file path (downloaded from Google Cloud Console)
GOOGLE_CREDENTIALS_FILE=credentials.json

# Polling interval in seconds (default: 60)
POLL_INTERVAL_SECONDS=60

# Create HubSpot notes for each email received (default: true)
CREATE_NOTES=true
