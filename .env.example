# HubSpot Private App Token (from HubSpot > Settings > Integrations > Private Apps)
HUBSPOT_API_KEY=your_hubspot_private_app_token_here

# Path to Gmail OAuth credentials JSON (downloaded from Google Cloud Console)
GMAIL_CREDENTIALS_FILE=credentials.json

# Path where the OAuth token will be saved after first authentication
GMAIL_TOKEN_FILE=token.json

# How often to check for new emails, in seconds (default: 60)
POLL_INTERVAL_SECONDS=60

# SQLite database path for tracking processed messages
STATE_DB_PATH=sync_state.db
