# Gmail OAuth2 credentials (from Google Cloud Console)
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# HubSpot Private App Token
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token_here

# Sync configuration
POLL_INTERVAL_SECONDS=60
STATE_FILE=sync_state.json
LOG_LEVEL=INFO

# Optional: email domains to skip (comma-separated)
SKIP_DOMAINS=noreply.com,no-reply.com,mailer-daemon.com
