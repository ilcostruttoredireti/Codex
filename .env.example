# ============================================================
# Gmail → HubSpot Contact Sync — Configurazione
# Copia questo file in .env e compila i valori
# ============================================================

# ── HubSpot ─────────────────────────────────────────────────
# Token di accesso per la tua HubSpot Private App
# https://app.hubspot.com/private-apps/<portal-id>
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token_here

# ── Gmail ────────────────────────────────────────────────────
# Percorso al file credentials.json scaricato da Google Cloud Console
# https://console.cloud.google.com/ → API Gmail → Credenziali OAuth2
GMAIL_CREDENTIALS_FILE=credentials.json

# File token generato automaticamente dopo il primo login
GMAIL_TOKEN_FILE=token.json

# Cartella Gmail da monitorare (INBOX, SENT, STARRED, UNREAD, o etichetta custom)
GMAIL_LABEL=INBOX

# Intervallo di polling in secondi (default: 60)
GMAIL_POLL_INTERVAL=60

# Numero massimo di email da recuperare per ciclo (default: 50)
GMAIL_MAX_RESULTS=50

# ── App ──────────────────────────────────────────────────────
# File JSON per tracciare i messaggi già processati
STATE_FILE=processed_messages.json

# Livello di log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Se true, esegue un solo ciclo e poi esce (utile per cron job)
RUN_ONCE=false
