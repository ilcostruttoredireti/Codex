# HubSpot Private App access token
# Create at: Settings → Integrations → Private Apps
HUBSPOT_ACCESS_TOKEN=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Gmail OAuth credentials (download from Google Cloud Console → APIs → Credentials)
# Place credentials.json in the project root; token.json is auto-generated on first run.

# How often to poll Gmail (seconds)
POLL_INTERVAL=60

# Gmail search query (standard Gmail syntax)
GMAIL_QUERY=in:inbox -from:me

# Max messages fetched per poll cycle
GMAIL_MAX_RESULTS=50

# Comma-separated emails to always skip (e.g. your own address)
SKIP_EMAILS=cristian.mameli.editore@gmail.com

# Path for the processed-message-ID state file
STATE_FILE=processed_ids.json
