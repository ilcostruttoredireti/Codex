# Gmail OAuth2 credentials (da Google Cloud Console)
GMAIL_CLIENT_ID=your_client_id_here
GMAIL_CLIENT_SECRET=your_client_secret_here
GMAIL_REFRESH_TOKEN=your_refresh_token_here
GMAIL_USER_EMAIL=your_gmail@gmail.com

# HubSpot Private App Token (da HubSpot > Impostazioni > Integrazioni > App private)
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token_here

# Configurazione sync
SYNC_INTERVAL_MINUTES=30
LOOKBACK_HOURS=24
DRY_RUN=false
