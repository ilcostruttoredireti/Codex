# HubSpot private app token
# Create one at: Settings → Integrations → Private Apps
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Gmail OAuth credentials file (downloaded from Google Cloud Console)
GMAIL_CREDENTIALS_FILE=credentials.json

# Where the OAuth token is persisted after first login
GMAIL_TOKEN_FILE=token.json

# How often to check Gmail for new messages (seconds)
POLL_INTERVAL_SECONDS=60

# File to persist sync state (last historyId + processed message IDs)
STATE_FILE=.sync_state.json
