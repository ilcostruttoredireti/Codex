# ── HubSpot ──────────────────────────────────────────────────────────────────
# Chiave API privata HubSpot (Settings → Integrations → Private Apps)
HUBSPOT_API_KEY=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Gmail OAuth2 ──────────────────────────────────────────────────────────────
# Percorso al file JSON scaricato da Google Cloud Console
# (APIs & Services → Credentials → OAuth 2.0 Client ID → Download JSON)
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.pickle

# ── Sync ──────────────────────────────────────────────────────────────────────
# Intervallo in secondi tra un ciclo e l'altro (default: 60)
CHECK_INTERVAL_SECONDS=60
