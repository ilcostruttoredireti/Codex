# ── HubSpot ───────────────────────────────────────────────────────────────────
# Create a Private App in HubSpot Settings → Integrations → Private Apps
# Required scopes: crm.objects.contacts.read, crm.objects.contacts.write,
#                  crm.objects.notes.write
HUBSPOT_API_KEY=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Gmail OAuth ───────────────────────────────────────────────────────────────
# Download from Google Cloud Console → APIs & Services → Credentials
# Enable: Gmail API
GMAIL_CREDENTIALS_FILE=credentials.json

# Cached OAuth token (auto-generated on first run)
GMAIL_TOKEN_FILE=token.json

# ── Sync behaviour ────────────────────────────────────────────────────────────
# Seconds between polling passes (only used with --loop)
POLL_INTERVAL_SECONDS=60

# Max Gmail messages fetched per pass
GMAIL_MAX_RESULTS=50

# File that stores processed message IDs (prevents re-processing)
PROCESSED_IDS_FILE=.processed_ids.json
