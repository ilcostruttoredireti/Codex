# ─── HubSpot ────────────────────────────────────────────────────────────────
# Create a Private App in HubSpot (Settings → Integrations → Private Apps).
# Required scopes: crm.objects.contacts.read  crm.objects.contacts.write
#                  crm.objects.notes.write
HUBSPOT_ACCESS_TOKEN=your-hubspot-private-app-token

# ─── Gmail ──────────────────────────────────────────────────────────────────
# 1. Go to https://console.cloud.google.com/ → create a project
# 2. Enable the Gmail API
# 3. Create OAuth2 Desktop credentials → download as credentials.json
# 4. On first run the browser will open for consent; token.json is saved after.
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# ─── Sync behaviour ─────────────────────────────────────────────────────────
# How often to check for new emails (seconds)
POLL_INTERVAL_SECONDS=60

# How many days back to scan on the very first run
LOOKBACK_DAYS=1

# File that tracks already-processed Gmail message IDs
STATE_FILE=sync_state.json
