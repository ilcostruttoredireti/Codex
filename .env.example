# ── HubSpot ──────────────────────────────────────────────────────────────────
# Chiave API HubSpot (Private App token)
# Crea una Private App su: Settings → Integrations → Private Apps
# Scope richiesti: crm.objects.contacts.read, crm.objects.contacts.write, crm.objects.notes.write
HUBSPOT_API_KEY=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Gmail ─────────────────────────────────────────────────────────────────────
# Percorso al file credentials.json scaricato da Google Cloud Console
# (API & Services → Credentials → OAuth 2.0 Client ID → Desktop App)
GMAIL_CREDENTIALS_PATH=credentials.json

# Percorso dove salvare il token OAuth (generato automaticamente al primo avvio)
GMAIL_TOKEN_PATH=token.pickle

# ── Sync ──────────────────────────────────────────────────────────────────────
# Intervallo tra un ciclo di polling e l'altro (secondi)
POLL_INTERVAL_SECONDS=60

# Numero massimo di messaggi da recuperare per ogni ciclo
MAX_MESSAGES_PER_POLL=100

# Query Gmail per filtrare i messaggi (sintassi Gmail)
GMAIL_QUERY=in:inbox

# Percorso al database SQLite locale per tracciare i messaggi già processati
DB_PATH=state.db
