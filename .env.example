# ── Gmail ─────────────────────────────────────────────────────────────────────
# Path to the OAuth2 credentials JSON downloaded from Google Cloud Console
# (APIs & Services → Credentials → OAuth 2.0 Client IDs → Download JSON)
GMAIL_CREDENTIALS_FILE=credentials.json

# Where to cache the OAuth token after first login (auto-created)
GMAIL_TOKEN_FILE=token.json

# ── HubSpot ───────────────────────────────────────────────────────────────────
# Private App token from HubSpot Settings → Integrations → Private Apps
# Required scopes: crm.objects.contacts.read, crm.objects.contacts.write,
#                  crm.objects.notes.write, timeline
HUBSPOT_TOKEN=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Sync behaviour ────────────────────────────────────────────────────────────
# Path to the JSON file that tracks processed message IDs
STATE_FILE=.sync_state.json

# Seconds between Gmail polls when running with --watch
POLL_INTERVAL_SECONDS=60
