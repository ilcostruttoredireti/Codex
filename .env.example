# HubSpot private app access token
HUBSPOT_ACCESS_TOKEN=your_hubspot_access_token_here

# Path to Gmail OAuth2 token (auto-created on first run)
GMAIL_TOKEN_FILE=gmail_token.json

# Path to Gmail OAuth2 credentials downloaded from Google Cloud Console
GMAIL_CREDENTIALS_FILE=gmail_credentials.json

# Comma-separated list of the account owner's own addresses (never imported)
SELF_ADDRESSES=cristian.mameli.editore@gmail.com,cristian.mameli@gmail.com,pubblica.latestata@gmail.com

# Comma-separated relay addresses whose bodies contain the real sender info
RELAY_ADDRESSES=redazione@latestata.it
