# HubSpot Private App Token
# Create one at: Settings > Integrations > Private Apps
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token_here

# Gmail OAuth2 credentials file path (downloaded from Google Cloud Console)
GMAIL_CREDENTIALS_FILE=credentials.json

# Gmail OAuth2 token file (auto-generated on first run)
GMAIL_TOKEN_FILE=token.json

# Gmail user to monitor (use "me" for the authenticated user)
GMAIL_USER_ID=me

# Polling interval in seconds (default: 60)
POLL_INTERVAL_SECONDS=60

# Only process emails from the last N days on first run (default: 1)
INITIAL_LOOKBACK_DAYS=1

# Domains to ignore when creating contacts (comma-separated)
# e.g. no-reply addresses, your own domain
IGNORED_DOMAINS=noreply.com,no-reply.com,mailer.com

# Your own email domains (senders from these will be skipped)
OWN_DOMAINS=
