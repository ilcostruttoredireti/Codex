# HubSpot Private App token
# Create one at: HubSpot → Settings → Integrations → Private Apps
# Required scopes: crm.objects.contacts.read, crm.objects.contacts.write, crm.objects.notes.write
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token_here

# How often to poll Gmail (seconds, default 60)
POLL_INTERVAL_SECONDS=60
