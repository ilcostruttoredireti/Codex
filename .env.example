# HubSpot Private App access token
# Create at: Settings → Integrations → Private Apps
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Gmail OAuth credentials file (downloaded from Google Cloud Console)
GOOGLE_CREDENTIALS_FILE=credentials.json

# Where to store the Gmail OAuth token after first login
GOOGLE_TOKEN_FILE=token.json

# How often to poll Gmail (seconds). Default: 60
POLL_INTERVAL_SECONDS=60

# File used to persist sync state between runs
STATE_FILE=sync_state.json

# Max messages to process per poll cycle. Default: 50
MAX_MESSAGES_PER_CYCLE=50

# Comma-separated list of sender domains to skip (no-reply addresses, etc.)
SKIP_DOMAINS=noreply.com,no-reply.com,mailer-daemon.com,notifications.com

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
