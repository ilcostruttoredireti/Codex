# ─── HubSpot ────────────────────────────────────────────────────────────────
# Private App Token: HubSpot → Impostazioni → Integrazioni → App private
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token_here

# ─── Gmail OAuth2 ───────────────────────────────────────────────────────────
# Scarica da Google Cloud Console → API e servizi → Credenziali → OAuth 2.0
GMAIL_CREDENTIALS_FILE=credentials.json
# Token generato automaticamente dopo il primo login
GMAIL_TOKEN_FILE=token.json

# ─── Comportamento ──────────────────────────────────────────────────────────
# Intervallo di controllo Gmail in secondi (default: 120 = 2 minuti)
POLL_INTERVAL_SECONDS=120

# File di stato interno (traccia le email già elaborate)
STATE_FILE=.sync_state.json

# Livello di log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
