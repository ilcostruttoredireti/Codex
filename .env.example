# ─── Gmail OAuth2 ─────────────────────────────────────────────────────────────
# Download from: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
GMAIL_CREDENTIALS_FILE=credentials.json

# Generated automatically on first run (browser OAuth flow)
GMAIL_TOKEN_FILE=token.json

# ─── HubSpot ──────────────────────────────────────────────────────────────────
# Create a Private App in HubSpot → Settings → Integrations → Private Apps
# Required scopes: crm.objects.contacts.read  crm.objects.contacts.write
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token_here

# ─── Sync behaviour ───────────────────────────────────────────────────────────
# How often to poll Gmail for new messages (seconds)
POLL_INTERVAL_SECONDS=60

# Max emails to process per cycle (Gmail API page size)
MAX_MESSAGES_PER_CYCLE=50
