# HubSpot Private App token
# Crea un'app privata su: https://app.hubspot.com/private-apps
# Scopes necessari: crm.objects.contacts.read, crm.objects.contacts.write, crm.objects.notes.write
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Percorso al file credentials.json scaricato da Google Cloud Console
# Abilita: Gmail API su https://console.cloud.google.com/apis/library/gmail.googleapis.com
GMAIL_CREDENTIALS_FILE=credentials.json
