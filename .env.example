# ── HubSpot ─────────────────────────────────────────────────────────────────
# Crea un Private App in HubSpot → Settings → Integrations → Private Apps
# Scope necessari: crm.objects.contacts.read, crm.objects.contacts.write,
#                  crm.objects.notes.write
HUBSPOT_API_KEY=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Gmail ────────────────────────────────────────────────────────────────────
# Percorso al file OAuth2 scaricato da Google Cloud Console
GMAIL_CREDENTIALS_FILE=credentials/gmail_credentials.json
# Token generato da setup_gmail_auth.py (creato automaticamente)
GMAIL_TOKEN_FILE=credentials/gmail_token.json

# ── Impostazioni sync ────────────────────────────────────────────────────────
# Intervallo di polling in secondi (default: 60)
POLL_INTERVAL=60

# File di stato per tracciare le email già processate
STATE_FILE=data/sync_state.json

# Domini da ignorare (separati da virgola)
EXCLUDE_DOMAINS=noreply.github.com,mailer.notion.so,notifications.google.com

# Ignora indirizzi no-reply (true/false)
EXCLUDE_NO_REPLY=true
