# HubSpot private app token (Settings → Integrations → Private Apps)
HUBSPOT_API_KEY=your_hubspot_private_app_token

# Gmail OAuth2 credentials file (downloaded from Google Cloud Console)
GMAIL_CREDENTIALS_FILE=gmail_credentials.json

# Gmail token file (auto-generated on first run)
GMAIL_TOKEN_FILE=gmail_token.json

# How many days of inbox history to process per run (default: 1)
SYNC_DAYS=1

# Max threads to process per run (default: 100)
SYNC_MAX_THREADS=100
