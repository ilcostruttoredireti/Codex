# HubSpot Private App token (Settings → Integrations → Private Apps)
HUBSPOT_ACCESS_TOKEN=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Path to Gmail OAuth2 token file (generated via oauth_setup.py)
GMAIL_CREDENTIALS_PATH=gmail_token.json

# How many hours of inbox history to scan per run (default: 1)
SYNC_HOURS_BACK=1
