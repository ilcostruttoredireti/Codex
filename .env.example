# ──────────────────────────────────────────────────────────────
# Gmail → HubSpot Sync — Configurazione
# Copia questo file in .env e compila i valori
# ──────────────────────────────────────────────────────────────

# HubSpot Private App Access Token
# Crea l'app su: HubSpot > Impostazioni > Integrazioni > App private
HUBSPOT_ACCESS_TOKEN=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Percorso al file credentials.json scaricato da Google Cloud Console
# Progetto → API & Servizi → Credenziali → OAuth 2.0 Client IDs
GMAIL_CREDENTIALS_FILE=config/credentials.json

# File token generato automaticamente al primo avvio (OAuth2 flow)
GMAIL_TOKEN_FILE=config/token.json

# Intervallo di polling in secondi (default: 60)
POLL_INTERVAL_SECONDS=60

# Percorso database SQLite per lo stato (traccia email già processate)
STATE_DB_PATH=data/sync_state.db

# Livello di log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Aggiungi etichetta Gmail "HubSpot-Synced" alle email processate (true/false)
ADD_GMAIL_LABEL=true
GMAIL_PROCESSED_LABEL=HubSpot-Synced

# Crea engagement email in HubSpot (timeline attività) (true/false)
CREATE_EMAIL_ENGAGEMENT=true

# Ore di lookback al primo avvio (quante ore indietro cercare email)
INITIAL_LOOKBACK_HOURS=24
