# ──────────────────────────────────────────────────────────────────────────────
# Gmail → HubSpot Sync — Configurazione
# Copia questo file in .env e compila i valori
# ──────────────────────────────────────────────────────────────────────────────

# HubSpot Private App Token
# Genera su: Impostazioni → Integrazioni → App private
HUBSPOT_ACCESS_TOKEN=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Percorso del file credentials.json scaricato da Google Cloud Console
GMAIL_CREDENTIALS_PATH=credentials.json

# Percorso dove salvare il token OAuth (generato automaticamente al primo login)
GMAIL_TOKEN_PATH=token.json

# Intervallo tra i controlli in secondi (default: 300 = 5 minuti)
POLL_INTERVAL_SECONDS=300

# Email da ignorare (separate da virgola) — in genere i tuoi account interni
SKIP_SENDERS=redazione@latestata.it,cristian.mameli.editore@gmail.com
