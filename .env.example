# -------------------------------------------------------
# Gmail → HubSpot Contact Sync — Variabili d'ambiente
# Copia questo file in .env e compila i valori reali.
# -------------------------------------------------------

# HubSpot Private App Token
# Crea una Private App su: HubSpot → Settings → Integrations → Private Apps
# Scopes necessari: crm.objects.contacts.read, crm.objects.contacts.write,
#                   crm.objects.notes.write
HUBSPOT_API_KEY=pat-xx-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Percorso al file credentials.json scaricato da Google Cloud Console
# (APIs & Services → Credentials → OAuth 2.0 Client ID → Desktop app)
GMAIL_CREDENTIALS_FILE=credentials.json

# Token OAuth generato al primo avvio (non modificare manualmente)
GMAIL_TOKEN_FILE=token.json

# Intervallo di polling in secondi (default: 60)
POLL_INTERVAL_SECONDS=60

# Livello di log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
