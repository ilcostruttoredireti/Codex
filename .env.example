# HubSpot private app token (Settings → Integrations → Private Apps)
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token

# Polling interval in seconds (default: 60)
POLL_INTERVAL_SECONDS=60

# Path to Gmail OAuth2 credentials JSON downloaded from Google Cloud Console
GMAIL_CREDENTIALS_FILE=credentials.json

# Path to store OAuth2 token after first auth
GMAIL_TOKEN_FILE=token.json

# Path to state file (tracks last processed Gmail message ID)
STATE_FILE=sync_state.json

# Log file path (leave empty to log to console only)
LOG_FILE=gmail_hubspot_sync.log
