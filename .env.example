# HubSpot Private App access token (Settings → Integrations → Private Apps)
HUBSPOT_API_KEY=pat-eu1-xxxxxxxxxxxxxxxxxxxx

# Paths to Gmail OAuth files (download from Google Cloud Console)
GMAIL_CREDENTIALS=credentials.json   # OAuth 2.0 client secret JSON
GMAIL_TOKEN=token.json               # auto-created on first run

# Optional: path to the state file tracking processed message IDs
STATE_FILE=state.json
