# ── HubSpot ──────────────────────────────────────────────────────────────────
# Private App access token da: Settings > Integrations > Private Apps
HUBSPOT_ACCESS_TOKEN=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Gmail OAuth ───────────────────────────────────────────────────────────────
# Percorso al file credentials.json scaricato da Google Cloud Console
GMAIL_CREDENTIALS=credentials.json
# Percorso dove salvare il token OAuth (generato al primo avvio)
GMAIL_TOKEN=token.json

# ── Comportamento ─────────────────────────────────────────────────────────────
# Il tuo indirizzo Gmail (le email inviate da te vengono ignorate)
MY_EMAIL=tuo@gmail.com
# Intervallo di polling in secondi (default: 60)
POLL_INTERVAL=60
