# ── Google Gmail ──────────────────────────────────────────────────────────────
# Percorso al file JSON scaricato da Google Cloud Console
# (API & Services → Credentials → OAuth 2.0 Client ID → Desktop app)
GOOGLE_CREDENTIALS_FILE=credentials.json

# Token generato automaticamente al primo avvio (non modificare)
GOOGLE_TOKEN_FILE=token.json

# ── HubSpot ───────────────────────────────────────────────────────────────────
# Private App Access Token da HubSpot
# (Settings → Integrations → Private Apps → Create private app)
# Scope minimi richiesti: crm.objects.contacts.read, crm.objects.contacts.write
# Scope opzionale per note: crm.objects.notes.write
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Sync config ───────────────────────────────────────────────────────────────
# Secondi tra un controllo e il successivo (default: 60)
POLL_INTERVAL_SECONDS=60

# File dove viene salvato lo stato tra un'esecuzione e l'altra
STATE_FILE=sync_state.json
