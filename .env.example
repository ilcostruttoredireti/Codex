# ── HubSpot ─────────────────────────────────────────────────────────────────
# Private App access token (Settings → Integrations → Private Apps)
HUBSPOT_ACCESS_TOKEN=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Gmail OAuth ──────────────────────────────────────────────────────────────
# Path to the OAuth 2.0 credentials JSON downloaded from Google Cloud Console
GMAIL_CREDENTIALS=credentials.json

# Path where the script caches the user OAuth token after first login
GMAIL_TOKEN=token.json

# ── Sync behaviour ───────────────────────────────────────────────────────────
# Seconds between Gmail polls (default 300 = 5 minutes)
POLL_INTERVAL=300

# Set to "false" to disable adding Gmail notes to the HubSpot timeline
ADD_TIMELINE_NOTES=true
