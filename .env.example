# Gmail OAuth2 credentials (scarica da Google Cloud Console)
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# Quanti giorni indietro scansionare
GMAIL_LOOKBACK_DAYS=7

# Query Gmail aggiuntiva (opzionale)
GMAIL_QUERY=in:inbox -from:me -from:mailer-daemon -from:noreply -from:no-reply -from:notification

# HubSpot Private App Token
HUBSPOT_API_KEY=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# File di stato per evitare riprocessamenti
STATE_FILE=.gmail_sync_state.json
