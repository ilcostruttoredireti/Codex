# ──────────────────────────────────────────────────────────────────────────
# Gmail → HubSpot Contact Sync  —  Configurazione
# Copia questo file in ".env" e compila i valori.
# ──────────────────────────────────────────────────────────────────────────

# ── Gmail OAuth2 ──────────────────────────────────────────────────────────
# Scarica il file delle credenziali da:
#   Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
#   Abilita l'API Gmail nel progetto Google Cloud.
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# ── HubSpot Private App ───────────────────────────────────────────────────
# Crea una Private App in:
#   HubSpot → Settings → Integrations → Private Apps
# Scope necessari: crm.objects.contacts.read, crm.objects.contacts.write,
#                  crm.objects.notes.write
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Comportamento sync ────────────────────────────────────────────────────
# Quante email scansionare al primo avvio
INITIAL_SCAN_LIMIT=100

# Secondi tra un ciclo e l'altro (modalità continua)
POLL_INTERVAL_SECONDS=60

# File di stato (traccia i messaggi già elaborati)
STATE_FILE=sync_state.json

# ── Filtri ────────────────────────────────────────────────────────────────
# Domini generici: il nome azienda NON viene inferito da questi domini
GENERIC_DOMAINS=gmail.com,yahoo.com,hotmail.com,outlook.com,icloud.com,protonmail.com,proton.me,live.com,msn.com,aol.com

# Mittenti da ignorare sempre (es. il tuo stesso indirizzo)
SKIP_SENDERS=me@example.com
