# HubSpot Private App Token
# Crea un'app privata su: Settings → Integrations → Private Apps
# Scope richiesti: crm.objects.contacts.read, crm.objects.contacts.write
HUBSPOT_API_KEY=your-hubspot-private-app-token

# Gmail OAuth2 – scarica il file da Google Cloud Console
# (API & Services → Credentials → OAuth 2.0 Client ID → Desktop app)
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# Sync settings
POLL_INTERVAL_SECONDS=300     # 5 minuti
STATE_FILE=sync_state.json    # IDs già elaborati
LOG_FILE=sync.log
