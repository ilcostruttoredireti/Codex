# ---------------------------------------------------------------
# Gmail → HubSpot Sync – variabili di configurazione
# Copia questo file in .env e compila i valori
# ---------------------------------------------------------------

# Token privato HubSpot (Settings → Integrations → Private App)
HUBSPOT_ACCESS_TOKEN=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Secondi tra un ciclo di polling e il successivo (default 60)
POLL_INTERVAL_SECONDS=60

# Domini da escludere dalla sincronizzazione (separati da virgola, opzionale)
# Esempio: noreply.github.com,mailer.stripe.com
SKIP_DOMAINS=
