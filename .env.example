# HubSpot Private App Access Token
# Create one at: Settings > Integrations > Private Apps
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Gmail OAuth2 credentials file (downloaded from Google Cloud Console)
GMAIL_CREDENTIALS_FILE=credentials.json

# Gmail token file (auto-generated after first auth)
GMAIL_TOKEN_FILE=token.json

# How often to check for new emails (seconds)
POLLING_INTERVAL_SECONDS=60

# How many inbox messages to fetch per cycle
MESSAGES_PER_RUN=50

# File to track already-processed message IDs
CHECKPOINT_FILE=.sync_checkpoint.json

# Create a HubSpot note on the contact for each email received (true/false)
CREATE_TIMELINE_ACTIVITY=true

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
