# HubSpot private app token (Settings → Integrations → Private Apps)
HUBSPOT_TOKEN=your_hubspot_private_app_token

# Gmail OAuth credentials (downloaded from Google Cloud Console)
GMAIL_CREDENTIALS_FILE=gmail_credentials.json
GMAIL_TOKEN_FILE=gmail_token.json

# Gmail search filter (default: only inbox, exclude your own sent mail)
GMAIL_QUERY=in:inbox -from:me

# How many days back to look on the very first run
LOOKBACK_DAYS=1

# Comma-separated sender addresses to always skip
SKIP_SENDERS=mailer-daemon@googlemail.com,noreply@google.com

# Comma-separated domains to skip (notification services, bounce handlers, etc.)
SKIP_DOMAINS=facebookmail.com,googlemail.com

# File used to persist the last sync timestamp and processed message IDs
STATE_FILE=.sync_state.json
