# Gmail OAuth2 credentials (download from Google Cloud Console)
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# Gmail address to monitor (leave empty to monitor authenticated account)
GMAIL_USER_EMAIL=me

# HubSpot Private App Token
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token_here

# Polling interval in seconds (default: 60)
POLL_INTERVAL_SECONDS=60

# SQLite state database path
STATE_DB_PATH=sync_state.db

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
