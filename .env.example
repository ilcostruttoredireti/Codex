# ── HubSpot ────────────────────────────────────────────────────────────────────
# Crea un Private App in HubSpot: Impostazioni → Integrazioni → App private
# Scope richiesti: crm.objects.contacts.read, crm.objects.contacts.write,
#                  crm.objects.notes.write
HUBSPOT_API_KEY=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Gmail OAuth ────────────────────────────────────────────────────────────────
# Scarica credentials.json da Google Cloud Console:
#   APIs & Services → Credentials → OAuth 2.0 Client IDs → Download JSON
GMAIL_CREDENTIALS_FILE=credentials.json

# Percorso dove verrà salvato il token OAuth dopo il primo login
GMAIL_TOKEN_FILE=token.json

# ── Polling ────────────────────────────────────────────────────────────────────
# Intervallo in secondi tra un controllo della casella e il successivo (default: 60)
POLL_INTERVAL_SECONDS=60
