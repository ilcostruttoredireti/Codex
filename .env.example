# ── HubSpot ───────────────────────────────────────────────────────────────────
# Private App token from HubSpot → Settings → Integrations → Private Apps
HUBSPOT_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Gmail OAuth ───────────────────────────────────────────────────────────────
# Path to the credentials.json downloaded from Google Cloud Console
# (OAuth 2.0 Client ID for a Desktop app, with Gmail API enabled)
CREDENTIALS_FILE=credentials.json

# Path where the OAuth access/refresh token will be stored after first login
TOKEN_FILE=token.json

# ── Sync behaviour ────────────────────────────────────────────────────────────
# How often (in seconds) to poll Gmail for new messages (default: 60)
POLL_INTERVAL=60

# File used to persist the Gmail historyId and processed-message cache
STATE_FILE=sync_state.json
