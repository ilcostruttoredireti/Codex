# ── Gmail ────────────────────────────────────────────────────────────────────
# File scaricato da Google Cloud Console → API & Services → Credentials
GMAIL_CREDENTIALS_FILE=credentials.json

# Generato automaticamente al primo avvio (OAuth flow)
GMAIL_TOKEN_FILE=token.json

# ── HubSpot ──────────────────────────────────────────────────────────────────
# Private App token: HubSpot → Settings → Integrations → Private Apps
HUBSPOT_API_KEY=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Sync ─────────────────────────────────────────────────────────────────────
# Intervallo di polling in secondi (default: 60)
POLL_INTERVAL_SECONDS=60

# File di stato per tracciare i messaggi già processati
STATE_FILE=sync_state.json
