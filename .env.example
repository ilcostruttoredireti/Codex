# ── Gmail OAuth2 ───────────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com → APIs → Gmail API → OAuth 2.0
GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-client-secret

# Obtain refresh token by running:  python -c "from gmail_hubspot_sync import run_oauth_flow; run_oauth_flow()"
GMAIL_REFRESH_TOKEN=your-refresh-token

# ── HubSpot ────────────────────────────────────────────────────────────────────
# Private App token: HubSpot → Settings → Integrations → Private Apps
# Required scopes: crm.objects.contacts.read, crm.objects.contacts.write, crm.objects.notes.write
HUBSPOT_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Behaviour ──────────────────────────────────────────────────────────────────
# Seconds between inbox polls (default 300 = 5 min)
POLL_INTERVAL=300

# Comma-separated sender addresses whose messages contain forwarded content.
# The script will parse the body to find the real original sender.
# Example: RELAY_SENDERS=redazione@latestata.it
RELAY_SENDERS=

# Extra Gmail search query appended to every poll (optional)
# Example: GMAIL_QUERY_EXTRA=label:press-kit
GMAIL_QUERY_EXTRA=

# Comma-separated senders to always ignore (your own addresses, internal bots)
IGNORE_SENDERS=

# Path to state file that tracks the last processed timestamp (default: state.json)
STATE_FILE=state.json
