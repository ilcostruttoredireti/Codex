# HubSpot Private App Token (obbligatorio)
# Crea in: HubSpot > Settings > Integrations > Private Apps
HUBSPOT_API_KEY=your_hubspot_private_app_token_here

# File delle credenziali OAuth2 Gmail (scarica da Google Cloud Console)
GMAIL_CREDENTIALS_FILE=credentials.json

# File token Gmail (generato automaticamente al primo avvio)
GMAIL_TOKEN_FILE=token.json

# Database SQLite per lo stato locale
STATE_DB_PATH=sync_state.db

# Intervallo di polling in secondi (default: 60)
POLL_INTERVAL=60

# Numero massimo di email da processare per ciclo (default: 50)
MAX_EMAILS_PER_RUN=50

# Livello di log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
