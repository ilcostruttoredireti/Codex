# ── HubSpot ──────────────────────────────────────────────────────────────────
# Create a Private App in HubSpot → Settings → Integrations → Private Apps
# Required scopes: crm.objects.contacts.read, crm.objects.contacts.write,
#                  crm.objects.notes.write
HUBSPOT_API_TOKEN=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Gmail (Google OAuth 2.0) ──────────────────────────────────────────────────
# 1. Go to Google Cloud Console → APIs & Services → Enable "Gmail API"
# 2. Create OAuth 2.0 Client ID (Desktop app) → download JSON → rename below
GMAIL_CREDENTIALS=credentials.json   # path to the downloaded OAuth JSON
GMAIL_TOKEN=token.json               # auto-created on first run

# ── Sync behaviour ────────────────────────────────────────────────────────────
POLL_INTERVAL=60      # seconds between Gmail checks (default: 60)
ADD_NOTES=true        # attach an activity note to each HubSpot contact
STATE_FILE=sync_state.json
