# HubSpot Private App access token
# Create at: HubSpot → Settings → Integrations → Private Apps
HUBSPOT_ACCESS_TOKEN=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Path to Google OAuth2 credentials JSON downloaded from Google Cloud Console
# Scopes needed: https://www.googleapis.com/auth/gmail.readonly
GOOGLE_CREDENTIALS=credentials.json
