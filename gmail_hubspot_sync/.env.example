# Gmail OAuth2 credentials (download from Google Cloud Console → APIs & Services → Credentials)
GMAIL_CREDENTIALS_FILE=credentials.json

# OAuth token cache (created automatically on first run)
GMAIL_TOKEN_FILE=token.json

# HubSpot Private App access token (Settings → Integrations → Private Apps)
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# How often to check for new emails (seconds, default 300 = 5 min)
POLL_INTERVAL_SECONDS=300

# Where to save sync state between runs
STATE_FILE=state.json

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Apply "Inbound Gmail" label to processed messages in Gmail (true/false)
LABEL_PROCESSED=false
