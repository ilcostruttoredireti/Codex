# ══════════════════════════════════════════════════
#  Gmail → HubSpot Sync — Variabili d'ambiente
#  Copia in .env e compila con i tuoi valori reali
# ══════════════════════════════════════════════════

# ── HubSpot ───────────────────────────────────────
# Chiave API privata (Settings → Integrations → API Key)
# OPPURE Private App Token (consigliato):
# Settings → Integrations → Private Apps → Create app
# Scope richiesti: crm.objects.contacts.read, crm.objects.contacts.write,
#                  crm.objects.notes.write
HUBSPOT_API_KEY=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Gmail OAuth2 ──────────────────────────────────
# Scarica da Google Cloud Console:
# APIs & Services → Credentials → OAuth 2.0 Client IDs → Download JSON
GMAIL_CREDENTIALS_FILE=credentials.json

# File token generato automaticamente al primo avvio (non modificare)
GMAIL_TOKEN_FILE=token.json

# ── Monitor ───────────────────────────────────────
# Intervallo di polling in secondi (default: 60)
POLL_INTERVAL_SECONDS=60

# File di stato (traccia gli ID già processati)
STATE_FILE=state.json
