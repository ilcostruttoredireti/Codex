# HubSpot Private App token
# Create one at: Settings → Integrations → Private Apps
HUBSPOT_ACCESS_TOKEN=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Path to the OAuth credentials JSON downloaded from Google Cloud Console
GMAIL_CREDENTIALS_FILE=credentials.json

# Path where the OAuth token will be cached after first login
GMAIL_TOKEN_FILE=token.json

# How often (seconds) to poll Gmail for new messages
POLL_INTERVAL_SECONDS=60

# Where to persist the last-seen Gmail historyId
STATE_FILE=.sync_state.json
