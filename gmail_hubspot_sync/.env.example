# Google OAuth2 credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_REFRESH_TOKEN=your_refresh_token_here

# HubSpot Private App Token (from HubSpot Settings > Integrations > Private Apps)
HUBSPOT_ACCESS_TOKEN=your_hubspot_access_token_here

# Sync settings
GMAIL_QUERY=in:inbox -from:me newer_than:1d
SYNC_INTERVAL_SECONDS=300
SKIP_DOMAINS=gmail.com,googlemail.com,mailer-daemon.googlemail.com
STATE_FILE=./processed_messages.json
