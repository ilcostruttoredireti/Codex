# ─────────────────────────────────────────────────────────────────────────────
# GMAIL – OAuth 2.0
# Ottieni le credenziali da Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# ─────────────────────────────────────────────────────────────────────────────
GMAIL_CLIENT_ID=your_gmail_client_id_here
GMAIL_CLIENT_SECRET=your_gmail_client_secret_here
# Dopo il primo avvio il token viene salvato in token.json — non serve impostarlo
GMAIL_TOKEN_FILE=token.json
GMAIL_CREDENTIALS_FILE=credentials.json

# ─────────────────────────────────────────────────────────────────────────────
# HUBSPOT – Private App Token
# Crea un'app privata in HubSpot: Impostazioni → Integrazioni → App private
# Scopes necessari: crm.objects.contacts.read, crm.objects.contacts.write
# ─────────────────────────────────────────────────────────────────────────────
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token_here

# ─────────────────────────────────────────────────────────────────────────────
# SYNC CONFIG
# ─────────────────────────────────────────────────────────────────────────────
# Intervallo in secondi tra un controllo e l'altro (default: 60)
POLL_INTERVAL_SECONDS=60

# Label Gmail da applicare alle email già processate
PROCESSED_LABEL=HubSpot-Synced

# Domìni da ignorare (separati da virgola) — es. newsletter, bot
IGNORE_DOMAINS=noreply.com,no-reply.com,mailer.com,mailchimp.com,sendgrid.net

# Fonte contatto registrata in HubSpot
CONTACT_SOURCE=Gmail

# Tag da applicare ai nuovi contatti
CONTACT_TAG=Inbound Gmail

# Percorso del file di log
LOG_FILE=sync.log
