# ─── Gmail OAuth2 ───────────────────────────────────────────────────────────
# Scarica da Google Cloud Console → API & Services → Credentials
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# ─── HubSpot ────────────────────────────────────────────────────────────────
# Crea in HubSpot → Settings → Integrations → Private Apps
HUBSPOT_API_KEY=pat-xx-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ─── Comportamento sync ─────────────────────────────────────────────────────
# Query Gmail (sintassi Gmail)
GMAIL_QUERY=in:inbox -from:me newer_than:1d

# Intervallo di polling in secondi (default: 60)
POLL_INTERVAL_SECONDS=60
