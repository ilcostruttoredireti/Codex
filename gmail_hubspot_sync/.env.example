# HubSpot Private App Token (Settings > Integrations > Private Apps)
HUBSPOT_API_KEY=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Path to Google OAuth credentials JSON (from Google Cloud Console)
GMAIL_CREDENTIALS_FILE=credentials.json

# Path where the OAuth token is persisted after first login
GMAIL_TOKEN_FILE=token.json

# Polling interval in seconds (default: 300 = 5 minutes)
POLL_INTERVAL_SECONDS=300

# State file to track processed thread IDs
STATE_FILE=.sync_state.json

# Comma-separated list of email addresses to SKIP (your own inbox addresses)
SKIP_ADDRESSES=cristian.mameli.editore@gmail.com,pubblica.latestata@gmail.com
