# HubSpot
HUBSPOT_ACCESS_TOKEN=your_private_app_token_here

# Gmail OAuth (path to credentials.json downloaded from Google Cloud Console)
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# Polling interval in seconds (default: 60)
POLL_INTERVAL_SECONDS=60

# Optional: label to apply to processed emails in Gmail
GMAIL_PROCESSED_LABEL=HubSpot-Synced
