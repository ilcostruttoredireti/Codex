# ── Gmail ─────────────────────────────────────────────────────────────────────
# Path to the OAuth2 credentials JSON downloaded from Google Cloud Console
GMAIL_CREDENTIALS_FILE=credentials.json

# Token cache written automatically after first auth
GMAIL_TOKEN_FILE=token.json

# ── HubSpot ───────────────────────────────────────────────────────────────────
# Private App access token  (Settings → Integrations → Private Apps)
HUBSPOT_ACCESS_TOKEN=your-hubspot-private-app-token

# ── Sync behaviour ────────────────────────────────────────────────────────────
# Seconds between polling cycles (only relevant with --loop)
POLL_INTERVAL_SECONDS=60

# Gmail label applied to processed messages (auto-created if missing)
PROCESSED_LABEL=HubSpot-Synced

# Comma-separated domains to skip
IGNORED_DOMAINS=noreply.com,mailer-daemon.com,google.com

# Comma-separated local-part prefixes to skip
IGNORED_PREFIXES=noreply,no-reply,donotreply,do-not-reply,mailer-daemon,bounce,postmaster

# File used to persist sync state between runs
STATE_FILE=.sync_state.json
