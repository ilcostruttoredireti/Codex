# ── Gmail ──────────────────────────────────────────────────────────────────────
# Path to the credentials.json downloaded from Google Cloud Console
GMAIL_CREDENTIALS_FILE=credentials.json

# Where the OAuth token is cached after the first browser login
GMAIL_TOKEN_FILE=token.json

# Gmail label applied to every processed message
GMAIL_PROCESSED_LABEL=HubSpot-Synced

# ── HubSpot ────────────────────────────────────────────────────────────────────
# Private App access token (Settings → Integrations → Private Apps)
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Sync behaviour ─────────────────────────────────────────────────────────────
# How often to poll Gmail for new messages (seconds)
POLL_INTERVAL_SECONDS=60

# File that stores the Gmail historyId between runs
STATE_FILE=.sync_state.json
