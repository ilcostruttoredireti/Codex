# HubSpot Private App token (Settings > Integrations > Private Apps)
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Gmail OAuth credentials file (download from Google Cloud Console)
GMAIL_CREDENTIALS_FILE=credentials.json

# Token file generated after first login (auto-created)
GMAIL_TOKEN_FILE=token.json

# Polling interval in seconds (default: 300 = 5 minutes)
POLL_INTERVAL_SECONDS=300

# Comma-separated emails to never import (e.g. your own address)
SKIP_EMAILS=cristian.mameli.editore@gmail.com

# State file to track processed messages across restarts
STATE_FILE=sync_state.json
