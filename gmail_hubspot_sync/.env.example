# Gmail OAuth2 credentials (download from Google Cloud Console)
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# HubSpot Private App access token
# https://developers.hubspot.com/docs/api/private-apps
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token_here

# File to persist processed message IDs between runs
STATE_FILE=sync_state.json

# How often to poll Gmail (in seconds). Default: 300 (5 min)
POLL_INTERVAL_SECONDS=300
