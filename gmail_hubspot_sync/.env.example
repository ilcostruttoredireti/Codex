# ── Gmail OAuth2 ──────────────────────────────────────────────────────────────
# Path to the credentials.json downloaded from Google Cloud Console
GMAIL_CREDENTIALS_FILE=credentials.json

# Path where the OAuth token is cached after first login
GMAIL_TOKEN_FILE=token.json

# ── HubSpot ───────────────────────────────────────────────────────────────────
# Private App access token (Settings → Integrations → Private Apps)
# Required scopes: crm.objects.contacts.read  crm.objects.contacts.write
HUBSPOT_ACCESS_TOKEN=your-hubspot-private-app-token

# ── Sync behaviour ────────────────────────────────────────────────────────────
# How often (in seconds) to poll Gmail for new messages (default: 300 = 5 min)
POLL_INTERVAL_SECONDS=300

# File used to persist the Gmail historyId between runs
STATE_FILE=sync_state.json
