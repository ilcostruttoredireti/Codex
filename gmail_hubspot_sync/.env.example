# Gmail OAuth credentials file (download from Google Cloud Console)
GMAIL_CREDENTIALS_FILE=credentials.json

# Gmail OAuth token file (auto-generated on first run)
GMAIL_TOKEN_FILE=token.json

# HubSpot Private App token
# Create at: HubSpot → Settings → Integrations → Private Apps
HUBSPOT_API_KEY=your-hubspot-private-app-token

# How many days back to scan Gmail (default: 1)
SEARCH_DAYS=1

# State file to track processed message IDs
STATE_FILE=.sync_state.json

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
