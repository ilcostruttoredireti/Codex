# ─── HubSpot ─────────────────────────────────────────────────────────────────
# Crea un Private App su: Settings → Integrations → Private Apps
# Scopes minimi richiesti: crm.objects.contacts.read, crm.objects.contacts.write
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token_here

# Opzionale: app ID per creare eventi nella timeline CRM
# HUBSPOT_TIMELINE_APP_ID=

# ─── Gmail ───────────────────────────────────────────────────────────────────
# Percorso del file credentials.json scaricato da Google Cloud Console
# (OAuth 2.0 → Desktop App, con scope gmail.readonly abilitato)
GMAIL_CREDENTIALS_PATH=credentials.json

# Percorso dove salvare il token OAuth (generato automaticamente al primo avvio)
GMAIL_TOKEN_PATH=token.json

# File di stato per il polling incrementale (Gmail History API)
GMAIL_HISTORY_FILE=.gmail_history_id

# ─── Sync ────────────────────────────────────────────────────────────────────
# Domini da escludere dalla sincronizzazione (separati da virgola)
# Utile per escludere il proprio dominio aziendale o notifiche automatiche
# SKIP_DOMAINS=miaazienda.com,noreply.github.com

# ─── Logging ─────────────────────────────────────────────────────────────────
# Livello di log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
