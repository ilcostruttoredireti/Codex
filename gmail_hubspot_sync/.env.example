# ── Required ──────────────────────────────────────────────────────────────────
# HubSpot private-app access token (Settings → Integrations → Private Apps)
HUBSPOT_TOKEN=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Path to the OAuth2 JSON file downloaded from Google Cloud Console
GMAIL_CREDENTIALS_FILE=credentials.json

# ── Optional ──────────────────────────────────────────────────────────────────
# Cached OAuth token (auto-created on first run; do NOT commit to git)
GMAIL_TOKEN_FILE=token.json

# Seconds between Gmail polls (default: 60)
POLL_INTERVAL_SECONDS=60

# JSON file that persists the Gmail historyId and processed message IDs
STATE_FILE=sync_state.json

# Comma-separated email domains to skip (e.g. your own company domain)
IGNORED_DOMAINS=mycompany.com,noreply.github.com
