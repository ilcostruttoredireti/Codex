# =============================================================
#  Gmail → HubSpot Contact Sync — Environment Variables
# =============================================================

# ── HubSpot ──────────────────────────────────────────────────
# Private App token (Settings → Integrations → Private Apps)
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Gmail OAuth2 ─────────────────────────────────────────────
# Path to credentials.json downloaded from Google Cloud Console
# (APIs & Services → Credentials → OAuth 2.0 Client IDs → Desktop app)
GMAIL_CREDENTIALS_PATH=credentials.json

# Path where the OAuth token will be stored after first login
GMAIL_TOKEN_PATH=token.json

# Gmail address to monitor (defaults to authenticated account)
GMAIL_MONITORED_ADDRESS=

# ── Sync behaviour ───────────────────────────────────────────
# How often to poll Gmail for new emails (seconds)
POLL_INTERVAL_SECONDS=60

# Gmail label used to mark already-processed messages
# The script creates it automatically if it does not exist
GMAIL_PROCESSED_LABEL=HubSpot-Synced

# Only process emails received after this ISO date (leave blank = all)
# Example: 2024-01-01T00:00:00Z
SYNC_SINCE_DATE=

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=sync.log
