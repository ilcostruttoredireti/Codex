# ── Gmail OAuth2 ─────────────────────────────────────────────────────────────
# Scarica questo file da Google Cloud Console → API & Services → Credentials
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# ── HubSpot ───────────────────────────────────────────────────────────────────
# HubSpot → Impostazioni → Integrazioni → App private → Crea app privata
# Scope richiesti: crm.objects.contacts.write, crm.objects.contacts.read
#                 crm.objects.notes.write
HUBSPOT_API_KEY=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Comportamento sync ────────────────────────────────────────────────────────
POLL_INTERVAL_SECONDS=60
CONTACT_SOURCE_LABEL=Gmail
CONTACT_TAG=Inbound Gmail
STATE_FILE=sync_state.json
