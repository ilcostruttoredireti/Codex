# HubSpot Private App Token
# Crea un Private App su: https://app.hubspot.com/private-apps
HUBSPOT_ACCESS_TOKEN=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Gmail OAuth2 - scarica da Google Cloud Console
# https://console.cloud.google.com/apis/credentials
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# Intervallo di polling in secondi (default: 60)
POLL_INTERVAL_SECONDS=60

# Label Gmail da monitorare (default: INBOX)
GMAIL_LABEL=INBOX

# Fonte contatto HubSpot
CONTACT_SOURCE=Gmail
