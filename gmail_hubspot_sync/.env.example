# ─── Gmail OAuth ───────────────────────────────────────────────────────────────
# Percorso al file credentials.json scaricato da Google Cloud Console
GMAIL_CREDS_FILE=credentials.json
# Percorso al file token.json generato al primo avvio (OAuth flow)
GMAIL_TOKEN_FILE=token.json

# ─── HubSpot ───────────────────────────────────────────────────────────────────
# Private App token: HubSpot → Impostazioni → Integrazioni → App private
HUBSPOT_API_KEY=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ─── Sync ──────────────────────────────────────────────────────────────────────
# Intervallo di polling in secondi (default 300 = 5 minuti)
POLL_INTERVAL_SEC=300
# File di stato persistente (salva l'historyId Gmail tra un ciclo e l'altro)
STATE_FILE=sync_state.json
