# ── HubSpot ──────────────────────────────────────────────────────────────────
# Crea un Private App su HubSpot: Settings → Integrations → Private Apps
# Scopes richiesti: crm.objects.contacts.read, crm.objects.contacts.write, crm.objects.notes.write
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Gmail OAuth ───────────────────────────────────────────────────────────────
# Scarica credentials.json da Google Cloud Console:
#   APIs & Services → Credentials → OAuth 2.0 Client IDs → Desktop App
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.pickle

# ── Sync settings ─────────────────────────────────────────────────────────────
STATE_FILE=sync_state.json
POLL_INTERVAL_SECONDS=60
