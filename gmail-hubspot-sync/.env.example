# HubSpot Private App token (Settings -> Integrations -> Private Apps)
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token

# Path to the Gmail OAuth2 credentials file downloaded from Google Cloud Console
GMAIL_CREDENTIALS_PATH=credentials.json

# Path where the OAuth2 token will be cached after the first login
GMAIL_TOKEN_PATH=token.pickle

# Maximum number of emails to process per run
MAX_EMAILS=200

# Gmail search query (default: all unread inbox emails)
GMAIL_QUERY=in:inbox is:unread -in:draft

# Value written to HubSpot "Lead Source" when creating/updating contacts
CONTACT_SOURCE_LABEL=Gmail

# Tag / note appended to new contacts (informational)
CONTACT_TAG=Inbound Gmail
