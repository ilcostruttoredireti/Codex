# HubSpot private app token (Settings > Integrations > Private Apps)
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Path to Google Cloud OAuth2 Desktop credentials JSON
GMAIL_CREDENTIALS_JSON=credentials.json

# Token cache (auto-created on first OAuth login)
GMAIL_TOKEN_JSON=token.json

# Days back to scan for new emails (default: 1)
DAYS_BACK=1

# Comma-separated sender addresses to always skip
SKIP_SENDERS=cristian.mameli.editore@gmail.com,cristian.mameli@gmail.com
